_:N0316b7040918480685ecab6942e9a9e9 a csvw:Column ;
    dct:description "Ethnicity"@en ;
    dct:isPartOf "race_and_ethnicity" ;
    dct:type "radio" ;
    skos:notation "0 = Unknown / Not Reported",
        "1 = NOT Hispanic or Latino",
        "2 = Hispanic or Latino" ;
    csvw:datatype "integer" ;
    csvw:name "ethnicity" ;
    csvw:title "Ethnicity"@en .

