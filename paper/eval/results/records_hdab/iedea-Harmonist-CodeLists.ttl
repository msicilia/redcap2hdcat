@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    healthdcatap:hdab [ a foaf:Agent ;
            foaf:homepage <https://www.fictional-hdab.invalid> ;
            foaf:mbox <mailto:hdab@fictional-hdab.invalid> ;
            foaf:name "Placeholder Health Data Access Body (fictional)" ] ;
    healthdcatap:healthCategory <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/EHRS> ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dct:conformsTo <https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml/dictionary> ;
    dct:creator [ a foaf:Agent ;
            foaf:mbox <mailto:group@fictional-institute.invalid> ;
            foaf:name "Fictional Research Group" ] ;
    dct:description "Harmonist 0B: Code Lists (IeDEA DES)"@en ;
    dct:identifier "https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml" ;
    dct:language "en" ;
    dct:publisher [ a foaf:Agent ;
            dct:type <https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/research-institute-org> ;
            foaf:homepage <https://www.fictional-institute.invalid> ;
            foaf:mbox <mailto:catalogue@fictional-institute.invalid> ;
            foaf:name "Fictional Health Research Institute" ] ;
    dct:title "Harmonist 0B: Code Lists (IeDEA DES)"@en ;
    adms:versionNotes "REDCap 8.1.1" ;
    dcat:contactPoint [ a vcard:Kind ;
            vcard:fn "Fictional Data Office" ;
            vcard:hasEmail <mailto:data-office@fictional-institute.invalid> ] ;
    dcat:keyword "code_list"@en ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> .

<https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml/dictionary> a csvw:TableGroup ;
    csvw:table <https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml/dictionary/table-0> .

<https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml/dictionary/table-0> a csvw:Table ;
    dct:title "code_list"@en ;
    csvw:tableSchema [ a csvw:Schema ;
            csvw:column [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "dropdown" ;
                    skos:notation "0 = Incomplete",
                        "1 = Unverified",
                        "2 = Complete" ;
                    csvw:datatype "integer" ;
                    csvw:name "code_list_complete" ;
                    csvw:titles "Complete?"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "notes" ;
                    csvw:datatype "string" ;
                    csvw:name "code_list" ;
                    csvw:titles """Code list
Format is "1 = Chocolate | 2 = Strawberry | 3 = Vanilla".
The Pipe character is required between codes because line breaks will be lost if the data dictionary (CSV) is used to update this field."""@en ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "notes" ;
                    csvw:datatype "string" ;
                    csvw:name "codelist_update_txt" ;
                    csvw:titles "Update Notes"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "list_name" ;
                    csvw:titles "Name of Code List"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "record_id" ;
                    csvw:required true ;
                    csvw:titles "Record ID"@en ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "text" ;
                    csvw:datatype "date" ;
                    csvw:name "codelist_update_d" ;
                    csvw:titles "Date code list last updated"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "radio" ;
                    skos:notation "1 = List of codes separated by pipe character",
                        "3 = CSV file upload with codes in column 1 and labels in column 2." ;
                    csvw:datatype "integer" ;
                    csvw:name "code_format" ;
                    csvw:titles "Choose a format for the code list:"@en ] ;
            csvw:primaryKey "record_id" ] .

