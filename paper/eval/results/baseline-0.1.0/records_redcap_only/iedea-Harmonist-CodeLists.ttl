@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dct:conformsTo <https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml/dictionary> ;
    dct:description "Harmonist 0B: Code Lists (IeDEA DES)" ;
    dct:identifier "https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml" ;
    dct:title "Harmonist 0B: Code Lists (IeDEA DES)" ;
    adms:versionNotes "REDCap 8.1.1" ;
    dcat:keyword "code_list" .

<https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml/dictionary> a csvw:TableGroup ;
    csvw:table <https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml/dictionary/table-0> .

<https://catalogue.fictional-institute.invalid/dataset/Harmonist0BCodeLists_2017-12-21_1148.REDCap.xml/dictionary/table-0> a csvw:Table ;
    dct:title "code_list" ;
    csvw:tableSchema [ a csvw:Schema ;
            csvw:column [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "list_name" ;
                    csvw:titles "Name of Code List" ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "text" ;
                    csvw:datatype "date" ;
                    csvw:name "codelist_update_d" ;
                    csvw:titles "Date code list last updated" ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "radio" ;
                    skos:notation "1 = List of codes separated by pipe character",
                        "3 = CSV file upload with codes in column 1 and labels in column 2." ;
                    csvw:datatype "integer" ;
                    csvw:name "code_format" ;
                    csvw:titles "Choose a format for the code list:" ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "dropdown" ;
                    skos:notation "0 = Incomplete",
                        "1 = Unverified",
                        "2 = Complete" ;
                    csvw:datatype "integer" ;
                    csvw:name "code_list_complete" ;
                    csvw:titles "Complete?" ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "notes" ;
                    csvw:datatype "string" ;
                    csvw:name "code_list" ;
                    csvw:titles """Code list
Format is "1 = Chocolate | 2 = Strawberry | 3 = Vanilla".
The Pipe character is required between codes because line breaks will be lost if the data dictionary (CSV) is used to update this field.""" ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "record_id" ;
                    csvw:required true ;
                    csvw:titles "Record ID" ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:isPartOf "code_list" ;
                    dct:type "notes" ;
                    csvw:datatype "string" ;
                    csvw:name "codelist_update_txt" ;
                    csvw:titles "Update Notes" ] ;
            csvw:primaryKey "record_id" ] .

