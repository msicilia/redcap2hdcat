@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dct:conformsTo <https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv/dictionary> ;
    dct:description "data-dictionary.csv" ;
    dct:identifier "https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv" ;
    dct:title "data-dictionary.csv" ;
    dcat:keyword "demographics",
        "health",
        "race_and_ethnicity" ;
    dpv:hasPersonalData true .

<https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv/dictionary> a csvw:TableGroup ;
    csvw:table <https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv/dictionary/table-0>,
        <https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv/dictionary/table-1>,
        <https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv/dictionary/table-2> .

<https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv/dictionary/table-0> a csvw:Table ;
    dct:title "demographics" ;
    csvw:tableSchema [ a csvw:Schema ;
            csvw:column [ a csvw:Column ;
                    dct:isPartOf "demographics" ;
                    dct:type "calc" ;
                    rdfs:comment "rounddown(datediff([dob],'today','y'))" ;
                    csvw:datatype "decimal" ;
                    csvw:name "age" ;
                    csvw:titles "Age (years)" ],
                [ a csvw:Column ;
                    dct:isPartOf "demographics" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "email" ;
                    csvw:titles "E-mail" ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:isPartOf "demographics" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "record_id" ;
                    csvw:required true ;
                    csvw:titles "Study ID" ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:isPartOf "demographics" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "name_first" ;
                    csvw:titles "First Name" ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:isPartOf "demographics" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "name_last" ;
                    csvw:titles "Last Name" ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:description "Include Area Code" ;
                    dct:isPartOf "demographics" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "telephone" ;
                    csvw:titles "Phone number" ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:isPartOf "demographics" ;
                    dct:type "text" ;
                    csvw:datatype "date" ;
                    csvw:name "dob" ;
                    csvw:titles "Date of birth" ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:isPartOf "demographics" ;
                    dct:type "notes" ;
                    csvw:datatype "string" ;
                    csvw:name "address" ;
                    csvw:titles "Street, City, State, ZIP" ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:isPartOf "demographics" ;
                    dct:type "radio" ;
                    skos:notation "0 = Female",
                        "1 = Male" ;
                    csvw:datatype "integer" ;
                    csvw:name "sex" ;
                    csvw:titles "Gender" ] ;
            csvw:primaryKey "record_id" ] .

<https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv/dictionary/table-1> a csvw:Table ;
    dct:title "health" ;
    csvw:tableSchema [ a csvw:Schema ;
            csvw:column [ a csvw:Column ;
                    dct:isPartOf "health" ;
                    dct:type "text" ;
                    csvw:datatype "decimal" ;
                    csvw:name "height" ;
                    csvw:titles "Height (cm)" ],
                [ a csvw:Column ;
                    dct:isPartOf "health" ;
                    dct:type "notes" ;
                    csvw:datatype "string" ;
                    csvw:name "comments" ;
                    csvw:titles "Comments" ],
                [ a csvw:Column ;
                    dct:isPartOf "health" ;
                    dct:type "text" ;
                    csvw:datatype "integer" ;
                    csvw:name "weight" ;
                    csvw:titles "Weight (kilograms)" ],
                [ a csvw:Column ;
                    dct:isPartOf "health" ;
                    dct:type "calc" ;
                    rdfs:comment "round(([weight]*10000)/(([height])^(2)),1)" ;
                    csvw:datatype "decimal" ;
                    csvw:name "bmi" ;
                    csvw:titles "BMI" ] ] .

<https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv/dictionary/table-2> a csvw:Table ;
    dct:title "race_and_ethnicity" ;
    csvw:tableSchema [ a csvw:Schema ;
            csvw:column [ a csvw:Column ;
                    dct:isPartOf "race_and_ethnicity" ;
                    dct:type "checkbox" ;
                    csvw:datatype "boolean" ;
                    csvw:name "race___1" ;
                    csvw:titles "Race (Select all that apply) (choice=American Indian/Alaska Native)" ],
                [ a csvw:Column ;
                    dct:isPartOf "race_and_ethnicity" ;
                    dct:type "checkbox" ;
                    csvw:datatype "boolean" ;
                    csvw:name "race___4" ;
                    csvw:titles "Race (Select all that apply) (choice=Black or African American)" ],
                [ a csvw:Column ;
                    dct:isPartOf "race_and_ethnicity" ;
                    dct:type "checkbox" ;
                    csvw:datatype "boolean" ;
                    csvw:name "race___6" ;
                    csvw:titles "Race (Select all that apply) (choice=Unknown / Not Reported)" ],
                [ a csvw:Column ;
                    dct:isPartOf "race_and_ethnicity" ;
                    dct:type "checkbox" ;
                    csvw:datatype "boolean" ;
                    csvw:name "race___5" ;
                    csvw:titles "Race (Select all that apply) (choice=White)" ],
                [ a csvw:Column ;
                    dct:isPartOf "race_and_ethnicity" ;
                    dct:type "checkbox" ;
                    csvw:datatype "boolean" ;
                    csvw:name "race___2" ;
                    csvw:titles "Race (Select all that apply) (choice=Asian)" ],
                [ a csvw:Column ;
                    dct:isPartOf "race_and_ethnicity" ;
                    dct:type "radio" ;
                    skos:notation "0 = Unknown / Not Reported",
                        "1 = NOT Hispanic or Latino",
                        "2 = Hispanic or Latino" ;
                    csvw:datatype "integer" ;
                    csvw:name "ethnicity" ;
                    csvw:titles "Ethnicity" ],
                [ a csvw:Column ;
                    dct:isPartOf "race_and_ethnicity" ;
                    dct:type "checkbox" ;
                    csvw:datatype "boolean" ;
                    csvw:name "race___3" ;
                    csvw:titles "Race (Select all that apply) (choice=Native Hawaiian or Other Pacific Islander)" ] ] .

