@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://catalogue.fictional-institute.invalid/dataset/test-case-01-data-dictionary.csv> a dcat:Dataset ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    healthdcatap:hdab [ a foaf:Agent ;
            foaf:homepage <https://www.fictional-hdab.invalid> ;
            foaf:mbox <mailto:hdab@fictional-hdab.invalid> ;
            foaf:name "Placeholder Health Data Access Body (fictional)" ] ;
    healthdcatap:healthCategory <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/EHRS> ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dct:conformsTo <https://catalogue.fictional-institute.invalid/dataset/test-case-01-data-dictionary.csv/dictionary> ;
    dct:creator [ a foaf:Agent ;
            foaf:mbox <mailto:group@fictional-institute.invalid> ;
            foaf:name "Fictional Research Group" ] ;
    dct:description "test-case-01-data-dictionary.csv"@en ;
    dct:identifier "https://catalogue.fictional-institute.invalid/dataset/test-case-01-data-dictionary.csv" ;
    dct:language "en" ;
    dct:publisher [ a foaf:Agent ;
            dct:type <https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/research-institute-org> ;
            foaf:homepage <https://www.fictional-institute.invalid> ;
            foaf:mbox <mailto:catalogue@fictional-institute.invalid> ;
            foaf:name "Fictional Health Research Institute" ] ;
    dct:title "test-case-01-data-dictionary.csv"@en ;
    dcat:contactPoint [ a vcard:Kind ;
            vcard:fn "Fictional Data Office" ;
            vcard:hasEmail <mailto:data-office@fictional-institute.invalid> ] ;
    dcat:keyword "my_first_instrument"@en ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> .

<https://catalogue.fictional-institute.invalid/dataset/test-case-01-data-dictionary.csv/dictionary> a csvw:TableGroup ;
    csvw:table <https://catalogue.fictional-institute.invalid/dataset/test-case-01-data-dictionary.csv/dictionary/table-0> .

<https://catalogue.fictional-institute.invalid/dataset/test-case-01-data-dictionary.csv/dictionary/table-0> a csvw:Table ;
    dct:title "my_first_instrument"@en ;
    csvw:tableSchema [ a csvw:Schema ;
            csvw:column [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "dateTime" ;
                    csvw:name "datetime_ymdhm" ;
                    csvw:titles "Datetime (ymdhm)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "checkbox" ;
                    csvw:datatype "boolean" ;
                    csvw:name "checkbox___2" ;
                    csvw:titles "Checkboxes (choice=Selection 2)"@en ],
                [ a csvw:Column ;
                    dct:description "Min: 01-01-2010"@en ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "date" ;
                    csvw:name "date_mdy" ;
                    csvw:titles "Date (MDY) [min, no max]"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "record_id" ;
                    csvw:required true ;
                    csvw:titles "Record ID"@en ;
                    dpv:hasPersonalData true ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "dateTime" ;
                    csvw:name "datetime_dmyhms" ;
                    csvw:titles "Datetime (dmy hms)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "dateTime" ;
                    csvw:name "datetime_mdyhm" ;
                    csvw:titles "Datetime (mdy hm)"@en ],
                [ a csvw:Column ;
                    dct:description "max: 100"@en ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "decimal" ;
                    csvw:name "number" ;
                    csvw:titles "Number [no min, max]"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "dropdown" ;
                    skos:notation "a_1 = Choice A1",
                        "b_2 = Choice B2",
                        "c_3 = Choice C3" ;
                    csvw:datatype "integer" ;
                    csvw:name "dropdown_mixed" ;
                    csvw:titles "Drop Down (mixed)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "phone" ;
                    csvw:titles "Phone (North America)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "slider" ;
                    csvw:datatype "integer" ;
                    csvw:name "slider" ;
                    csvw:titles "Slider"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "dropdown" ;
                    skos:notation "a = Choice A",
                        "b = Choice B",
                        "c = Choice C" ;
                    csvw:datatype "integer" ;
                    csvw:name "dropdown_character" ;
                    csvw:titles "Drop Down (character code)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "zip" ;
                    csvw:titles "ZIP Code"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "checkbox" ;
                    csvw:datatype "boolean" ;
                    csvw:name "checkbox___1" ;
                    csvw:titles "Checkboxes (choice=Selection 1)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "checkbox" ;
                    csvw:datatype "boolean" ;
                    csvw:name "checkbox___3" ;
                    csvw:titles "Checkboxes (choice=Selection 3)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "email" ;
                    csvw:titles "Email"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "dropdown" ;
                    skos:notation "1 = Choice One",
                        "2 = Choice Two",
                        "3 = Choice Three" ;
                    csvw:datatype "integer" ;
                    csvw:name "dropdown_numeric" ;
                    csvw:titles "Drop Down (numeric code)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "notes" ;
                    csvw:datatype "string" ;
                    csvw:name "notes" ;
                    csvw:titles "Notes Box"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "radio" ;
                    skos:notation "1 = Choice 1",
                        "2 = Choice 2",
                        "3 = Choice 3" ;
                    csvw:datatype "integer" ;
                    csvw:name "radio_buttons" ;
                    csvw:titles "Radio Buttons"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "calc" ;
                    rdfs:comment "[integer] + [number]" ;
                    csvw:datatype "decimal" ;
                    csvw:name "calculated" ;
                    csvw:titles "Calculated Field (integer + number)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "dateTime" ;
                    csvw:name "datetime_mdyhms" ;
                    csvw:titles "Datetime (mdy hms)"@en ],
                [ a csvw:Column ;
                    dct:description "Min 01-01-2010 00:00; Max 31-12-2019 23:59"@en ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "dateTime" ;
                    csvw:name "datetime_dmyhm" ;
                    csvw:titles "Datetime (dmy hm) [min, max]"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "truefalse" ;
                    csvw:datatype "boolean" ;
                    csvw:name "true_false" ;
                    csvw:titles "True/False"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "yesno" ;
                    csvw:datatype "boolean" ;
                    csvw:name "yes_no" ;
                    csvw:titles "Yes/No"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "date" ;
                    csvw:name "date_dmy" ;
                    csvw:titles "Date (DMY) [no min, no max]"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "string" ;
                    csvw:name "unvalidated_text" ;
                    csvw:titles "Unvalidated Text"@en ],
                [ a csvw:Column ;
                    dct:description "Max: 2019-12-31"@en ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "date" ;
                    csvw:name "date_ymd" ;
                    csvw:titles "Date (YMD) [no min, max]"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "time" ;
                    csvw:name "time" ;
                    csvw:titles "Time (HH:MM)"@en ],
                [ a csvw:Column ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "dateTime" ;
                    csvw:name "datetime_ymdhms" ;
                    csvw:titles "Datetime (ymd hms)"@en ],
                [ a csvw:Column ;
                    dct:description "Min: 0"@en ;
                    dct:isPartOf "my_first_instrument" ;
                    dct:type "text" ;
                    csvw:datatype "integer" ;
                    csvw:name "integer" ;
                    csvw:titles "Integer [min, no max]"@en ] ;
            csvw:primaryKey "record_id" ] .

