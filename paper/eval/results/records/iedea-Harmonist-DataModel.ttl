_:N008463f396d140ae8cb07cedeb9a26db a csvw:Column ;
    dct:description "Select code list:"@en ;
    dct:isPartOf "variable_metadata" ;
    dct:type "dropdown" ;
    skos:notation "1 = ART_ID code (ATC drug code)",
        "10 = IeDEA Regions",
        "11 = COUNTRY code (ISO alpha-3)",
        "12 = RURAL code",
        "13 = LEVEL code",
        "14 = ADULTPED code",
        "15 = SURVEY_INTERNET code",
        "16 = SURVEY_PAPER code",
        "17 = DELIV_M code",
        "18 = DELIV_LOCATION code",
        "19 = DELIV_ASSIST code",
        "2 = _D_A code (date approximation)",
        "20 = DIS_ID code",
        "21 = DIS_WD code",
        "22 = DIS_SITE code",
        "23 = DIS_OUTCOME code",
        "24 = BP_U code",
        "25 = CD4_U code",
        "26 = _NoYes",
        "27 = MED_ID code (ATC drug code)",
        "28 = VS_ID code",
        "29 = RNA_T code",
        "3 = ART_RS/MED_RS code",
        "30 = LAB_ID code",
        "31 = LAB_U code",
        "32 = DROP_RS code",
        "33 = ABNORM code",
        "34 = LOC_CODE code",
        "35 = ROM_DUR_A code",
        "36 = LAB_R/VS_R code",
        "37 = LAB_ST code",
        "38 = TESTTYPE code",
        "39 = VIRUSTYPE code",
        "4 = ART_FORM code",
        "40 = GENE code",
        "41 = AA_POS_SUB code",
        "42 = RES_SCOR_ID code",
        "43 = MEDSTART_RS code",
        "44 = MED_FR code",
        "45 = ULTR code",
        "46 = VS_U code",
        "47 = OUTCOM code",
        "48 = HIV_STATUS code",
        "49 = CAREGIVER code",
        "5 = ART_COMB code",
        "50 = CDC_STAGE code",
        "51 = WHO_STAGE code",
        "52 = STATUS_KNOWN code",
        "53 = SCHOOL_LVL code",
        "54 = GENDER_ID code",
        "6 = ARTSTART_RS code",
        "7 = GENDER code",
        "8 = MODE code",
        "9 = _NoYesUnknown" ;
    csvw:datatype "integer" ;
    csvw:name "code_list_ref" ;
    csvw:title "Select code list:"@en .

