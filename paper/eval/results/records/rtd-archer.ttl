_:N309ca8902af04e9b8cf9cad580679fff a csvw:Column ;
    dct:description "Completion status of the instrument."@en ;
    dct:isPartOf "demographics" ;
    dct:type "dropdown" ;
    skos:notation "0 = Incomplete",
        "1 = Unverified",
        "2 = Complete" ;
    csvw:datatype "integer" ;
    csvw:name "demographics_complete" ;
    csvw:title "Complete?"@en .

_:N42e4e34ea3b9453d96adefc90f027981 a csvw:Column ;
    dct:description "BMI"@en ;
    dct:isPartOf "health" ;
    dct:type "calc" ;
    rdfs:comment "round(([weight]*10000)/(([height])^(2)),1)" ;
    csvw:datatype "decimal" ;
    csvw:name "bmi" ;
    csvw:title "BMI"@en .

