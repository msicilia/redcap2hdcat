_:N0745726926fb49918abe500e7f48c889 a csvw:Column ;
    dct:description "Age (years)"@en ;
    dct:isPartOf "demographics" ;
    dct:type "calc" ;
    rdfs:comment "rounddown(datediff([dob],'today','y'))" ;
    csvw:datatype "decimal" ;
    csvw:name "age" ;
    csvw:title "Age (years)"@en .

_:N111c078bee0d43f9b6e19cb8e1e0c65a a csvw:Column ;
    dct:description "Study ID"@en ;
    dct:isPartOf "demographics" ;
