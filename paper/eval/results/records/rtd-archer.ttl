_:Nf369f5a6ff564bb3999b845c84c61d25 a csvw:Column ;
    dct:description "BMI"@en ;
    dct:isPartOf "health" ;
    dct:type "calc" ;
    rdfs:comment "round(([weight]*10000)/(([height])^(2)),1)" ;
