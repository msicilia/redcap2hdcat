    csvw:name "name_last" ;
    csvw:title "Last Name"@en ;
    dpv:hasPersonalData dpv-pd:Identifying .

_:N09737c123a224eaf8608b04c0a01a654 a csvw:Column ;
    dct:description "Gender"@en ;
    dct:isPartOf "demographics" ;
    dct:type "radio" ;
    skos:notation "0 = Female",
        "1 = Male" ;
    csvw:datatype "integer" ;
