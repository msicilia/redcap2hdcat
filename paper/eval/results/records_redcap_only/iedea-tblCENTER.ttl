_:N55fd67b769ca4f2387813df261ade903 a csvw:Column ;
    dct:description """SURVEY_PAPER
<div style="font-weight:lighter;font-style:italic">Resources for printing and transferring paper surveys to a central location for data entry</div>""" ;
    dct:isPartOf "tblcenter" ;
    dct:type "dropdown" ;
    skos:notation "1 = site has resources to print and transfer surveys",
        "2 = site has resources to print, but not to transfer surveys",
        "3 = site does not have resources to print, but can transfer surveys",
        "4 = site needs assistance in both printing and transferring surveys",
        "8 = not applicable",
        "9 = Unknown" ;
    csvw:datatype "integer" ;
    csvw:name "survey_paper" ;
    csvw:title """SURVEY_PAPER
<div style="font-weight:lighter;font-style:italic">Resources for printing and transferring paper surveys to a central location for data entry</div>""" .

