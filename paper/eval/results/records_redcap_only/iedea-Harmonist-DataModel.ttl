        "23 = DIS_OUTCOME code",
        "24 = BP_U code",
        "25 = CD4_U code",
        "26 = _NoYes",
        "27 = MED_ID code (ATC drug code)",
        "28 = VS_ID code",
        "29 = RNA_T code",
        "3 = ART_RS/MED_RS code",
        "30 = LAB_ID code",
        "31 = LAB_U code",
        "32 = DROP_RS code",
        "33 = ABNORM code",
        "34 = LOC_CODE code",
        "35 = ROM_DUR_A code",
        "36 = LAB_R/VS_R code",
        "37 = LAB_ST code",
        "38 = TESTTYPE code",
        "39 = VIRUSTYPE code",
        "4 = ART_FORM code",
        "40 = GENE code",
