    dct:description "data-dictionary.csv" ;
    dct:identifier "https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv" ;
    dct:provenance [ a dct:ProvenanceStatement ;
            rdfs:label "Data collected in REDCap on 3 instruments. This description was derived from the project's data dictionary by redcap2hdcat."@en ] ;
    dct:title "data-dictionary.csv" ;
