        "race_and_ethnicity" ;
    dpv:hasPersonalData dpv-pd:BirthDate,
        dpv-pd:EmailAddress,
        dpv-pd:Health,
        dpv-pd:Identifying,
        dpv-pd:TelephoneNumber .

