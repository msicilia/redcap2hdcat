    dct:description "data-dictionary.csv" ;
    dct:identifier "https://catalogue.fictional-institute.invalid/dataset/data-dictionary.csv" ;
    dct:provenance [ a dct:ProvenanceStatement ;
            rdfs:label "Data captured through electronic case report forms in REDCap (3 instruments). This description was derived from the project's data dictionary by redcap2hdcat."@en ] ;
    dct:title "data-dictionary.csv" ;
    dcat:keyword "demographics",
        "health",
        "race_and_ethnicity" ;
    dpv:hasPersonalData dpv-pd:BirthDate,
        dpv-pd:EmailAddress,
        dpv-pd:Health,
        dpv-pd:Identifying,
        dpv-pd:TelephoneNumber .

