_:N414aac01dcc0406785af76331305309b a csvw:Column ;
    dct:description "BMI" ;
    dct:isPartOf "health" ;
    dct:type "calc" ;
    rdfs:comment "round(([weight]*10000)/(([height])^(2)),1)" ;
    csvw:datatype "decimal" ;
    csvw:name "bmi" ;
    csvw:title "BMI" .

