_:N048b860e22554e6c8e56e48f85cb9290 a csvw:Column ;
    dct:description "BMI" ;
    dct:isPartOf "health" ;
    dct:type "calc" ;
    rdfs:comment "round(([weight]*10000)/(([height])^(2)),1)" ;
    csvw:datatype "decimal" ;
    csvw:name "bmi" ;
    csvw:title "BMI" .

_:N13d1b24d0c854b998b4e5ad8eba4e520 a csvw:Column ;
    dct:description "Race (Select all that apply) (choice=Black or African American)" ;
