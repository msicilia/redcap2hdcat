   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_NONEURO9"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001558</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_NONEURO9</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="sv">Medlemsstater utanför euroområdet: Bulgarien, Tjeckien, Danmark, Kroatien, Ungern, Polen, Rumänien, Sverige, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice izvan europodručja: Bugarska, Češka, Danska, Hrvastka, Mađarska, Poljska, Rumunjska, Švedska, Ujedinjena Kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroalueen ulkopuoliset jäsenvaltiot: Bulgaria, Tšekki, Tanska, Kroatia, Unkari, Puola, Romania, Ruotsi, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Estados miembros no pertenecientes a la zona del euro: Bulgaria, Chequia, Dinamarca, Croacia, Hungría, Polonia, Rumanía, Suecia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki niso v euroobmočju: Bolgarija, Češka, Danska, Hrvaška, Madžarska, Poljska, Romunija, Švedska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres n’appartenant pas à la zone euro: Bulgarie, Tchéquie, Danemark, Croatie, Hongrie, Pologne, Roumanie, Suède, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">State membre din afara zonei euro: Bulgaria, Cehia, Danemarca, Croația, Ungaria, Polonia, România, Suedia, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwo członkowskie spoza strefy euro: Bułgaria, Czechy, Dania, Chorwacja, Węgry, Polska, Rumunia, Szwecja, Zjednoczone Królestwo</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ballstáit nach bhfuil sa limistéar euro: an Bhulgáir, an tSeicia, an Danmhairg, an Chróit, an Ungáir, an Pholainn, an Rómáin, an tSualainn, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Lidstaten buiten de eurozone: Bulgarije, Tsjechië, Denemarken, Kroatië, Hongarije, Polen, Roemenië, Zweden, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Euróövezeten kívüli tagállamok: Bulgária, Csehország, Dánia, Horvátország, Magyarország, Lengyelország, Románia, Svédország, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členský štát, ktorý nie je krajinou eurozóny: Bulharsko, Česko, Dánsko, Chorvátsko, Maďarsko, Poľsko, Rumunsko, Švédsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nicht dem Euro-Währungsgebiet angehörende Mitgliedstaaten: Bulgarien, Tschechien, Dänemark, Kroatien, Ungarn, Polen, Rumänien, Schweden, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Estados-Membros não participante na área do euro: Bulgária, Chéquia, Dinamarca, Croácia, Hungria, Polónia, Roménia, Suécia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κράτη μέλη εκτός ζώνης ευρώ: Βουλγαρία, Τσεχία, Δανία, Κροατία, Ουγγαρία, Πολωνία, Ρουμανία, Σουηδία, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Medlemsstater uden for Euroområdet: Bulgarien, Tjekkiet, Danmark, Kroatien, Ungarn, Polen, Rumænien, Sverige, Det Forenede Kongerige</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Stati membri non appartenenti all’area dell’euro: Bulgaria, Cechia, Danimarca, Croazia, Ungheria, Polonia, Romania, Svezia, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri mhux fiż-żona tal-euro: il-Bulgarija, iċ-Ċekja, id-Danimarka, il-Kroazja, l-Ungerija, il-Polonja, ir-Rumanija, l-Isvezja, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras neietilpst eurozonā: Bulgārija, Čehija, Dānija, Horvātija, Ungārija, Polija, Rumānija, Zviedrija, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroalasse mittekuuluvad liikmesriigid: Bulgaaria, Tšehhi, Taani, Horvaatia, Ungari, Poola, Rumeenia, Rootsi, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy mimo eurozónu: Bulharsko, Česko, Dánsko, Chorvatsko, Maďarsko, Polsko, Rumunsko, Švédsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави членки извън еврозоната: България, Чехия, Дания, Хърватия, Унгария, Полша, Румъния, Швеция, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Euro zonai nepriklausančios valstybės narės: Bulgarija, Čekija, Danija, Kroatija, Vengrija, Lenkija, Rumunija, Švedija, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Non-euro area Member States: Bulgaria, Czechia, Denmark, Croatia, Hungary, Poland, Romania, Sweden, United Kingdom</skos:prefLabel>
      <dc:identifier>EUMS_NONEURO9</dc:identifier>
      <atold:op-code>EUMS_NONEURO9</atold:op-code>
      <at:op-code>EUMS_NONEURO9</at:op-code>
      <at:start.use>2018-09-18</at:start.use>
      <at:authority-code>EUMS_NONEURO9</at:authority-code>
      <at:end.use>2020-01-31</at:end.use>
      <skos:historyNote xml:lang="en">Deprecated since the withdrawal of the United Kingdom from the European Union.</skos:historyNote>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_EURO11"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_EURO11</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000340</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="pt">Os Estados-Membros que adoptaram o euro: Bélgica, Alemanha, Irlanda, Espanha, França, Itália, Luxemburgo, Países Baixos, Áustria, Portugal, Finlândia</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice koje su prihvatile euro: Belgija, Njemačka, Irska, Španjolska, Francuska, Italija, Luksemburg, Nizozemska, Austrija, Portugal, Finska</skos:prefLabel>
      <skos:prefLabel xml:lang="it">I Stati membri che hanno adottato l’euro: Belgio, Germania, Irlanda, Spagna, Francia, Italia, Lussemburgo, Paesi Bassi, Austria, Portogallo, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De medlemsstater, der har indført euroen: Belgien, Tyskland, Irland, Spanien, Frankrig, Italien, Luxembourg, Nederlandene, Østrig, Portugal, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="en">The Member States having adopted the euro: Belgium, Germany, Ireland, Spain, France, Italy, Luxembourg, Netherlands, Austria, Portugal, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Los Estados miembros que han adoptado el euro: Bélgica, Alemania, Irlanda, España, Francia, Italia, Luxemburgo, Países Bajos, Austria, Portugal, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Statele membre care au adoptat euro: Belgia, Germania, Irlanda, Spania, Franţa, Italia, Luxemburg, Ţările de Jos, Austria, Portugalia, Finlanda</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Az eurót bevezető tagállamok: Belgium, Németország, Írország, Spanyolország, Franciaország, Olaszország, Luxemburg, Hollandia, Ausztria, Portugália, Finnország</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Die Mitgliedstaaten, die den Euro eingeführt haben: Belgien, Deutschland, Irland, Spanien, Frankreich, Italien, Luxemburg, Niederlande, Österreich, Portugal, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Valstybės narės, įsivedusios eurą: Belgija, Vokietija, Airija, Ispanija, Prancūzija, Italija, Liuksemburgas, Nyderlandai, Austrija, Portugalija, Suomija</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Na Ballstáit a ghlac leis an euro: an Bheilg, an Ghearmáin, Éire, an Spáinn, an Fhrainc, an Iodáil, Lucsamburg, an Ísiltír, an Ostair, an Phortaingéil, an Fhionlainn</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členské štáty, ktoré prijali euro: Belgicko, Nemecko, Írsko, Španielsko, Francúzsko, Taliansko, Luxembursko, Holandsko, Rakúsko, Portugalsko, Fínsko</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres ayant adopté l’euro: Belgique, Allemagne, Irlande, Espagne, France, Italie, Luxembourg, Pays-Bas, Autriche, Portugal, Finlande</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τα κράτη μέλη που υιοθέτησαν το ευρώ: Βέλγιο, Γερμανία, Ιρλανδία, Ισπανία, Γαλλία, Ιταλία, Λουξεμβούργο, Κάτω Χώρες, Αυστρία, Πορτογαλία, Φινλανδία</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri wara li adottaw l-euro: il-Belġju, il-Ġermanja, l-Irlanda, Spanja, Franza, l-Italja, il-Lussemburgu, il-Pajjiżi l-Baxxi, l-Awstrija, il-Portugall, il-Finlandja</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">De medlemsstater som har infört euron: Belgien, Tyskland, Irland, Spanien, Frankrike, Italien, Luxemburg, Nederländerna, Österrike, Portugal, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras ir ieviesušas euro: Beļģija, Vācija, Īrija, Spānija, Francija, Itālija, Luksemburga, Nīderlande, Austrija, Portugāle, Somija</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави-членки, които са приели еврото: Белгия, Германия, Ирландия, Испания, Франция, Италия, Люксембург, Нидерландия, Австрия, Португалия, Финландия</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy, které přijaly euro: Belgie, Německo, Irsko, Španělsko, Francie, Itálie, Lucembursko, Nizozemsko, Rakousko, Portugalsko, Finsko</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euro kasutusele võtnud liikmesriigid: Belgia, Saksamaa, Iirimaa, Hispaania, Prantsusmaa, Itaalia, Luksemburg, Madalmaad, Austria, Portugal, Soome</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwa członkowskie, które przyjęły walutę euro: Belgia, Niemcy, Irlandia, Hiszpania, Francja, Włochy, Luksemburg, Niderlandy, Austria, Portugalia, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki so sprejele euro: Belgija, Nemčija, Irska, Španija, Francija, Italija, Luksemburg, Nizozemska, Avstrija, Portugalska, Finska</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">De lidstaten die de euro hebben aangenomen: België, Duitsland, Ierland, Spanje, Frankrijk, Italië, Luxemburg, Nederland, Oostenrijk, Portugal, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Jäsenvaltiot, jotka ovat ottaneet käyttöön euron: Belgia, Saksa, Irlanti, Espanja, Ranska, Italia, Luxemburg, Alankomaat, Itävalta, Portugali, Suomi</skos:prefLabel>
      <dc:identifier>EUMS_EURO11</dc:identifier>
      <atold:op-code>EUMS_EURO11</atold:op-code>
      <at:op-code>EUMS_EURO11</at:op-code>
      <at:start.use>1999-01-01</at:start.use>
      <at:authority-code>EUMS_EURO11</at:authority-code>
      <at:end.use>2000-12-31</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS12"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000331</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FD_050">12EM</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS12</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="en">The twelve Member States: Belgium, Denmark, Germany, Ireland, Greece, Spain, France, Italy, Luxembourg, Netherlands, Portugal, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Dvanáct členských států: Belgie, Dánsko, Německo, Irsko, Řecko, Španělsko, Francie, Itálie, Lucembursko, Nizozemsko, Portugalsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Kaksitoista jäsenvaltiota: Belgia, Tanska, Saksa, Irlanti, Kreikka, Espanja, Ranska, Italia, Luxemburg, Alankomaat, Portugali, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Cele douăsprezece state membre: Belgia, Danemarca, Germania, Irlanda, Grecia, Spania, Franţa, Italia, Luxemburg, Ţările de Jos, Portugalia, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">De twaalf lidstaten: België, Denemarken, Duitsland, Ierland, Griekenland, Spanje, Frankrijk, Italië, Luxemburg, Nederland, Portugal, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">De tolv medlemsstaterna: Belgien, Danmark, Tyskland, Irland, Grekland, Spanien, Frankrike, Italien, Luxemburg, Nederländerna, Portugal, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Dwanaście państw członkowskich: Belgia, Dania, Niemcy, Irlandia, Grecja, Hiszpania, Francja, Włochy, Luksemburg, Niderlandy, Portugalia, Zjednoczone Królestwo</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Dvylika valstybių narių: Belgija, Danija, Vokietija, Airija, Graikija, Ispanija, Prancūzija, Italija, Liuksemburgas, Nyderlandai, Portugalija, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Die zwölf Mitgliedstaaten: Belgien, Dänemark, Deutschland, Irland, Griechenland, Spanien, Frankreich, Italien, Luxemburg, Niederlande, Portugal, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Dvanaest država članica: Belgija, Danska, Njemačka, Irska, Grčka, Španjolska, Francuska, Italija, Luksemburg, Nizozemska, Portugal, Ujedinjena Kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">It-tnax-il Stat Membru: il-Belġju, id-Danimarka, il-Ġermanja, l-Irlanda, il-Greċja, Spanja, Franza, l-Italja, il-Lussemburgu, il-Pajjiżi l-Baxxi, il-Portugall, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Dvanajst držav članic: Belgija, Danska, Nemčija, Irska, Grčija, Španija, Francija, Italija, Luksemburg, Nizozemska, Portugalska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Дванадесетте държави-членки: Белгия, Дания, Германия, Ирландия, Гърция, Испания, Франция, Италия, Люксембург, Нидерландия, Португалия, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="it">I dodici Stati membri: Belgio, Danimarca, Germania, Irlanda, Grecia, Spagna, Francia, Italia, Lussemburgo, Paesi Bassi, Portogallo, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Los doce Estados miembros: Bélgica, Dinamarca, Alemania, Irlanda, Grecia, España, Francia, Italia, Luxemburgo, Países Bajos, Portugal, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">A tizenkét tagállam: Belgium, Dánia, Németország, Írország, Görögország, Spanyolország, Franciaország, Olaszország, Luxemburg, Hollandia, Portugália, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Os doze Estados-Membros: Bélgica, Dinamarca, Alemanha, Irlanda, Grécia, Espanha, França, Itália, Luxemburgo, Países Baixos, Portugal, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Dvanásť členských štátov: Belgicko, Dánsko, Nemecko, Írsko, Grécko, Španielsko, Francúzsko, Taliansko, Luxembursko, Holandsko, Portugalsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Les douze États membres: Belgique, Danemark, Allemagne, Irlande, Grèce, Espagne, France, Italie, Luxembourg, Pays-Bas, Portugal, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">An Dá Bhallstát Déag: an Bheilg, an Danmhairg, an Ghearmáin, Éire, an Ghréig, an Spáinn, an Fhrainc, an Iodáil, Lucsamburg, an Ísiltír, an Phortaingéil, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τα δώδεκα κράτη μέλη: Βέλγιο, Δανία, Γερμανία, Ιρλανδία, Ελλάδα, Ισπανία, Γαλλία, Ιταλία, Λουξεμβούργο, Κάτω Χώρες, Πορτογαλία, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Divpadsmit dalībvalstis: Beļģija, Dānija, Vācija, Īrija, Grieķija, Spānija, Francija, Itālija, Luksemburga, Nīderlande, Portugāle, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Kaksteist liikmesriiki: Belgia, Taani, Saksamaa, Iirimaa, Kreeka, Hispaania, Prantsusmaa, Itaalia, Luksemburg, Madalmaad, Portugal, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De tolv medlemsstater: Belgien, Danmark, Tyskland, Irland, Grækenland, Spanien, Frankrig, Italien, Luxembourg, Nederlandene, Portugal, Det Forenede Kongerige</skos:prefLabel>
      <dc:identifier>EUMS12</dc:identifier>
