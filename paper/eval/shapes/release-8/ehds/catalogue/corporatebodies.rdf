      <skos:prefLabel xml:lang="lv">Sociālās politikas, izglītības, nodarbinātības, pētniecības un kultūras komisija</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Sosiaalipolitiikka, koulutus, työllisyys, tutkimus ja kulttuuri -valiokunta</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Utskottet för socialpolitik, utbildning, sysselsättning, forskning och kultur</skos:prefLabel>
