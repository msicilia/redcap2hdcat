      <at:end.use>2022-10-31</at:end.use>
      <skos:altLabel xml:lang="fr">Service de la secrétaire générale adjointe pour la PSDC et la réaction aux crises</skos:altLabel>
      <skos:altLabel xml:lang="de">Dienst der stellvertretenden Generalsekretärin für GSVP und Krisenreaktion</skos:altLabel>
