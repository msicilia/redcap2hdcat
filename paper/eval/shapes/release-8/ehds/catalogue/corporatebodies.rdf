      <skos:altLabel xml:lang="et">Ajutine komitee (BSE)</skos:altLabel>
      <skos:altLabel xml:lang="hu">Ideiglenes bizottság (BSE)</skos:altLabel>
      <skos:altLabel xml:lang="fr">Commission temporaire (ESB)</skos:altLabel>
      <skos:altLabel xml:lang="sk">Docasný výbor (BSE)</skos:altLabel>
      <skos:altLabel xml:lang="ro">Comisia temporară (ESB)</skos:altLabel>
      <skos:altLabel xml:lang="bg">Временна комисия (BSE)</skos:altLabel>
      <skos:altLabel xml:lang="el">Προσωρινή επιτροπή για την παρακολούθηση των συστά</skos:altLabel>
      <skos:altLabel xml:lang="sl">Začasni odbor (BSE)</skos:altLabel>
