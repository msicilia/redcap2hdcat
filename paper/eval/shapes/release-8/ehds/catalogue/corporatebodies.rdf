      <skos:altLabel xml:lang="fr">CEA</skos:altLabel>
      <skos:altLabel xml:lang="it">Commissione economica per l’Africa</skos:altLabel>
      <skos:altLabel xml:lang="ro">CEA</skos:altLabel>
      <skos:altLabel xml:lang="el">Οικονομική Επιτροπή για την Αφρική</skos:altLabel>
