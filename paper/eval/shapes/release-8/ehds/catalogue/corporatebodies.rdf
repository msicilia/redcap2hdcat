      <skos:altLabel xml:lang="nl">NAT</skos:altLabel>
      <skos:altLabel xml:lang="hu">NAT szekció</skos:altLabel>
      <skos:altLabel xml:lang="el">Τμήμα NAT</skos:altLabel>
