      <skos:altLabel xml:lang="da">INCB</skos:altLabel>
      <skos:altLabel xml:lang="nl">INCB</skos:altLabel>
      <skos:altLabel xml:lang="hu">INCB</skos:altLabel>
      <skos:altLabel xml:lang="el">INCB</skos:altLabel>
