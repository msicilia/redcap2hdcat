   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EEAS_CSDP"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EEAS_CSDP</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001403</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EEAS"/>
      <skos:prefLabel xml:lang="hr">Služba zamjenika glavnog tajnika za ZSOP i za odgovor na krizne situacije</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Dienst des stellvertretenden Generalsekretärs für GSVP und Krisenreaktion</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Servicio del secretario general adjunto de la PCSD y respuesta a las crisis</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Služba namestnika generalnega sekretarja za SVOP in krizno odzivanje</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Service of Deputy Secretary General CSDP and crisis response</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Útvar zástupce generálního tajemníka pro SBOP a reakci na krize</skos:prefLabel>
      <skos:prefLabel xml:lang="et">ÜJKP ja kriisihalduse asepeasekretäri talitus</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Seirbhís an Leas-Ardrúnaí do CBSC agus freagairt ar ghéarchéimeanna</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Útvar zástupcu generálneho tajomníka SBOP a reakcie na krízu</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Už BSGP ir reagavimą į krizes atsakingo generalinio sekretoriaus pavaduotojo tarnyba</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Υπηρεσία του Αναπληρωτή Γενικού Γραμματέα για την ΚΠΑΑ και την αντιμετώπιση κρίσεων</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Tjänst knuten till biträdande generalsekreteraren för GSFP och krishantering</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">A KBVP-ért és a válságelhárításért felelős főtitkárhelyettes munkáját segítő szolgálat</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Tjeneste tilknyttet vicegeneralsekretæren for FSFP og kriserespons</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Dienst van de adjunct-secretaris-generaal GVDB en crisisrespons</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">YTPP:stä ja kriisinhallinnasta vastaavan apulaispääsihteerin yksikkö</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Serviciu pe lângă Secretarul general adjunct pentru PSAC și răspunsul în caz de criză</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dienests, kas pakļauts ģenerālsekretāra vietniekam jautājumos, kuri skar KDAP un reaģēšanu uz krīzēm</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Служба на заместник генерален секретар за ОПСО и реакция при кризи</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Servizz ta’ Deputat Segretarju Ġenerali tas-CSDP u r-rispons f’sitwazzjonijiet ta’ kriżi</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Biuro zastępcy sekretarza generalnego ds. WPBiO i reagowania kryzysowego</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Service du secrétaire général adjoint pour la PSDC et la réaction aux crises</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Serviços do Secretário-Geral adjunto para a PCSD e a resposta a crises</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Servizio del Segretario generale aggiunto per la PSDC e la risposta alle crisi</skos:prefLabel>
      <dc:identifier>EEAS_CSDP</dc:identifier>
