      <skos:altLabel xml:lang="sl">ITC (Unctad/WTO)</skos:altLabel>
      <skos:altLabel xml:lang="cs">Mezinárodní obchodní centrum UNCTAD/WTO</skos:altLabel>
      <skos:altLabel xml:lang="ga">Lárionad Trádála Idirnáisiúnta UNCTAD/WTO</skos:altLabel>
      <skos:altLabel xml:lang="ro">Contrul de comerț internațional OMC-UNCTAD</skos:altLabel>
      <skos:altLabel xml:lang="fr">Centre CNUCED/OMC du commerce international</skos:altLabel>
      <skos:altLabel xml:lang="bg">МТЦ</skos:altLabel>
      <skos:exactMatch rdf:resource="http://eurovoc.europa.eu/5278"/>
      <skos:definition xml:lang="en">The ITC has been recognized by the Economic and Social Council as the focal point of the United Nations system for technical cooperation with developing countries in trade promotion. The title "International Trade Centre UNCTAD/WTO" came into force on 1 Jan 1995, which was when the Centre began to be jointly operated by the World Trade Organization and the UN. Since 1984 ITC has been an executing agency of the United Nations Development Programme (UNDP), directly responsible for implementing UNDP-financed projects in developing countries and economies in transition related to trade promotion.</skos:definition>
   </skos:Concept>
