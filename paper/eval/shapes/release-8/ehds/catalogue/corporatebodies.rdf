      <skos:prefLabel xml:lang="mt">L-Aġenzija Eżekuttiva għall-Konsumatur, is-Saħħa, l-Agrikoltura u l-Ikel</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Consumers, Health, Agriculture and Food Executive Agency</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Výkonná agentúra pre spotrebiteľov, zdravie, poľnohospodárstvo a potraviny</skos:prefLabel>
