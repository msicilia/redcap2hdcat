      <skos:prefLabel xml:lang="ga">An Coiste Stiúrtha um an gCultúr, an Oidhreacht agus an Tírdhreach</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Stuurgroep Cultuur, Erfgoed en Landschap</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Styrkommittén för kultur, kulturarv och landskap</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Kultúráért, Örökségért és Tájért Felelős Irányítóbizottság</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kumitat tat-Tmexxija għall-Kultura, il-Wirt u l-Pajsaġġ</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Steering Committee for Culture, Heritage and Landscape</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Kulttuurin, kulttuuriperinnön ja maiseman johtokomitea</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Comité Director de Cultura, Patrimonio y Paisaje</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Usmerjevalni odbor za kulturo, dediščino in krajino</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Comitato direttivo per la cultura, il patrimonio e il paesaggio</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Διευθύνουσα επιτροπή για τον πολιτισμό, την πολιτιστική κληρονομιά και το φυσικό τοπίο</skos:prefLabel>
      <dc:identifier>COU_EUR_CDCPP</dc:identifier>
      <atold:op-code>COU_EUR_CDCPP</atold:op-code>
      <at:op-code>COU_EUR_CDCPP</at:op-code>
      <at:start.use>2012-01-01</at:start.use>
      <at:authority-code>COU_EUR_CDCPP</at:authority-code>
      <skos:definition xml:lang="en">The Steering Committee for Culture, Heritage and Landscape superceded the previous specialised Committees in the field of culture, heritage and landscape – the Steering Committee for Education, the Steering Committee for Higher Education and Research, the Steering Committee for Culture and the Steering Committee for Cultural Heritage – and now oversees all the activities implemented by the Council of Europe in these sectors.</skos:definition>
   </skos:Concept>
