      <skos:prefLabel xml:lang="de">Horizontale Gruppe „Stärkung der Resilienz und Abwehr hybrider Bedrohungen“</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Horyzontalna Grupa Robocza ds. Wzmacniania Odporności i Przeciwdziałania Zagrożeniom Hybrydowym</skos:prefLabel>
