      <skos:prefLabel xml:lang="fr">Comité directeur pour les politiques et pratiques éducatives</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Comité Director de Políticas y Prácticas Educativas</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Komitet Sterujący ds. Polityki i Praktyki Edukacyjnej</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Steering Committee for Education Policy and Practice</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Upravljački odbor za obrazovnu politiku i praksu</skos:prefLabel>
