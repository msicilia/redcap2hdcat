      <at:authority-code>EUMS_NONEURO11</at:authority-code>
      <at:end.use>2010-12-31</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/BANK_EURO12"
