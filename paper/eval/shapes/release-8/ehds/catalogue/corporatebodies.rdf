   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS9"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000329</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS9</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FD_050">9EM</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="hu">A kilenc tagállam: Belgium, Dánia, Németország, Írország, Franciaország, Olaszország, Luxemburg, Hollandia, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Devet država članica: Belgija, Danska, Njemačka, Irska, Francuska, Italija, Luksemburg, Nizozemska, Ujedinjena Kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">De negen lidstaten: België, Denemarken, Duitsland, Ierland, Frankrijk, Italië, Luxemburg, Nederland, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Üheksa liikmesriiki: Belgia, Taani, Saksamaa, Iirimaa, Prantsusmaa, Itaalia, Luksemburg, Madalmaad, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Devět členských států: Belgie, Dánsko, Německo, Irsko, Francie, Itálie, Lucembursko, Nizozemsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">De nio medlemsstaterna: Belgien, Danmark, Tyskland, Irland, Frankrike, Italien, Luxemburg, Nederländerna, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Yhdeksän jäsenvaltiota: Belgia, Tanska, Saksa, Irlanti, Ranska, Italia, Luxemburg, Alankomaat, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Deväť členských štátov: Belgicko, Dánsko, Nemecko, Írsko, Francúzsko, Taliansko, Luxembursko, Holandsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Cele nouă state membre: Belgia, Danemarca, Germania, Irlanda, Franţa, Italia, Luxemburg, Ţările de Jos, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Id-disa’ Stati Membri: il-Belġju, id-Danimarka, il-Ġermanja, l-Irlanda, Franza, l-Italja, il-Lussemburgu, il-Pajjiżi l-Baxxi, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τα εννιά κράτη μέλη: Βέλγιο, Δανία, Γερμανία, Ιρλανδία, Γαλλία, Ιταλία, Λουξεμβούργο, Κάτω Χώρες, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Los nueve Estados miembros: Bélgica, Dinamarca, Alemania, Irlanda, Francia, Italia, Luxemburgo, Países Bajos, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Na Naoi mBallstát: an Bheilg, an Danmhairg, an Ghearmáin, Éire, an Fhrainc, an Iodáil, Lucsamburg, an Ísiltír, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Devet držav članic: Belgija, Danska, Nemčija, Irska, Francija, Italija, Luksemburg, Nizozemska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Devynios valstybės narės: Belgija, Danija, Vokietija, Airija, Prancūzija, Italija, Liuksemburgas, Nyderlandai, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Новтте държави-членки: Белгия, Дания, Германия, Ирландия, Франция, Италия, Люксембург, Нидерландия, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="it">I nove Stati membri: Belgio, Danimarca, Germania, Irlanda, Francia, Italia, Lussemburgo, Paesi Bassi, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Die neun Mitgliedstaaten: Belgien, Dänemark, Deutschland, Irland, Frankreich, Italien, Luxemburg, Niederlande, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="en">The nine Member States: Belgium, Denmark, Germany, Ireland, France, Italy, Luxembourg, Netherlands, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Dziewięć państw członkowskich: Belgia, Dania, Niemcy, Irlandia, Francja, Włochy, Luksemburg, Niderlandy, Zjednoczone Królestwo</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Os nove Estados-Membros: Bélgica, Dinamarca, Alemanha, Irlanda, França, Itália, Luxemburgo, Países Baixos, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De ni medlemsstater: Belgien, Danmark, Tyskland, Irland, Frankrig, Italien, Luxembourg, Nederlandene, Det Forenede Kongerige</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Les neuf États membres: Belgique, Danemark, Allemagne, Irlande, France, Italie, Luxembourg, Pays-Bas, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Deviņas dalībvalstis: Beļģija, Dānija, Vācija, Īrija, Francija, Itālija, Luksemburga, Nīderlande, Apvienotā Karaliste</skos:prefLabel>
      <dc:identifier>EUMS9</dc:identifier>
      <atold:op-code>EUMS9</atold:op-code>
      <at:op-code>EUMS9</at:op-code>
      <at:start.use>1973-01-01</at:start.use>
      <at:authority-code>EUMS9</at:authority-code>
      <at:end.use>1980-12-31</at:end.use>
