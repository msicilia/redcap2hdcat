      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/COM"/>
      <skos:prefLabel xml:lang="pt">Direção-Geral do Desenvolvimento e das Relações com os Estados de África, das Caraíbas e do Pacífico</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ard Stiúrthóireacht na Forbartha agus an Chaidrimh le Stáit san Afraic, i Muir Chairib agus san Aigéan Ciúin</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Dirección General de Desarrollo y Relaciones con los Estados de África, del Caribe y del Pacífico</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Generaldirektoratet för utveckling och förbindelser med stater i Afrika, Västindien och Stillahavsområdet</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Direzione generale dello Sviluppo e i rapporti con gli Stati dell’Africa, dei Caraibi e del Pacifico</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Generaldirektion Entwicklung und Beziehungen zu afrikanischen, karibischen und pazifischen Staaten</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Directorate-General for Development and Relations with African, Caribbean and Pacific States</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Генерална дирекция „Развитие и отношения с държавите от Африка, Карибите и Тихоокеанския басейн“</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Direcţia Generală Dezvoltare și relații cu statele din Africa, Caraibe și Pacific</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Glavna uprava za razvoj i odnose s afričkim, karipskim i pacifičkim državama</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Generalni direktorat za razvoj in odnose z afriškimi, karibskimi in pacifiškimi državami</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Vystymosi ir santykių su Afrikos, Karibų ir Ramiojo vandenyno šalimis generalinis direktoratas</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Attīstības un attiecību ar Āfrikas, Karību jūras reģiona un Klusā okeāna valstīm ģenerāldirektorāts</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Dyrekcja Generalna ds. Rozwoju oraz Stosunków z Państwami Afryki, Karaibów i Pacyfiku</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Directoraat-generaal Ontwikkeling en Betrekkingen met de Staten in Afrika, het Caribisch Gebied en de Stille Oceaan</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Generální ředitelství pro rozvoj a vztahy s africkými, karibskými a tichomořskými státy</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">A Fejlesztésért és az Afrikai, Karibi és Csendes-óceáni Kapcsolatokért Felelős Főigazgatóság</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Generaldirektoratet for Udvikling og Forbindelser med Afrika, Caribien og Stillehavsstaterne</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Generálne riaditeľstvo pre rozvoj a vzťahy s africkými, karibskými a tichomorskými štátmi</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Id-Direttorat Ġenerali għall-Iżvilupp u r-Relazzjonijiet mal-Istati Afrikani, tal-Karibew u tal-Paċifiku</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Direction générale du développement et des relations avec les États d’Afrique, des Caraïbes et du Pacifique</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Kehitysyhteistyön sekä Afrikan, Karibian ja Tyynenmeren -suhteiden pääosasto</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Γενική Διεύθυνση Ανάπτυξης και Σχέσεων με τα κράτη της Αφρικής, της Καραϊβικής και του Ειρηνικού</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Arengu ning Aafrika, Kariibi mere ja Vaikse ookeani piirkonna riikidega suhete edendamise peadirektoraat</skos:prefLabel>
