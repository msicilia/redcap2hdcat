            <dc:source>WHOISWHO</dc:source>
            <at:legacy-code>EEAS_CRF_240834</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">Service of Deputy Secretary General of the European External Action Service manages issues related with the Common Security and Defence Policy and crisis response.</skos:definition>
