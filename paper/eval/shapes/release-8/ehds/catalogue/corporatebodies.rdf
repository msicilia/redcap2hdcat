      <skos:prefLabel xml:lang="lt">Vartotojų, sveikatos, žemės ūkio ir maisto programų vykdomoji agentūra</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Patērētāju, veselības, lauksaimniecības un pārtikas izpildaģentūra</skos:prefLabel>
