   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_EURO"
                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_EURO</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001808</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="ro">Statele membre care au adoptat euro</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Valstybės narės, įsivedusios eurą</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Na Ballstáit a ghlac leis an euro</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri wara li adottaw l-euro</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">De lidstaten die de euro hebben aangenomen</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De medlemsstater, der har indført euroen</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Jäsenvaltiot, jotka ovat ottaneet käyttöön euron</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Az eurót bevezető tagállamok</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras ir ieviesušas euro</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Die Mitgliedstaaten, die den Euro eingeführt haben</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Los Estados miembros que han adoptado el euro</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice koje su prihvatile euro</skos:prefLabel>
      <skos:prefLabel xml:lang="en">The Member States having adopted the euro</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави-членки, които са приели еврото</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τα κράτη μέλη που υιοθέτησαν το ευρώ</skos:prefLabel>
      <skos:prefLabel xml:lang="it">I Stati membri che hanno adottato l’euro</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki so sprejele euro</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwa członkowskie, które przyjęły walutę euro</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy, které přijaly euro</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euro kasutusele võtnud liikmesriigid</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Os Estados-Membros que adoptaram o euro</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres ayant adopté l’euro</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">De medlemsstater som har infört euron</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členské štáty, ktoré prijali euro</skos:prefLabel>
      <dc:identifier>EUMS_EURO</dc:identifier>
      <atold:op-code>EUMS_EURO</atold:op-code>
      <at:op-code>EUMS_EURO</at:op-code>
      <at:start.use>1999-01-01</at:start.use>
      <at:authority-code>EUMS_EURO</at:authority-code>
      <skos:definition xml:lang="en">member states of the European Union that have adopted the euro as their primary currency and sole legal tender</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUROSYSTEM"
                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000826</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUROSYSTEM</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="bg">Евросистема</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Eurosystème</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Eurosistēma</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Eurosystemet</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Eurosystemet</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Eurojärjestelmä</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">An tEurochóras</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Eurosüsteem</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Eurosistema</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Ευρωσύστημα</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Eurosistema</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Eurosistema</skos:prefLabel>
