      <skos:altLabel xml:lang="nl">Raad van de Europese Economische Ruimte</skos:altLabel>
      <skos:altLabel xml:lang="hr">Vijeće Europskoga gospodarskog prostora</skos:altLabel>
      <skos:altLabel xml:lang="ga">Comhairle an Limistéir Eorpaigh Eacnamaíoch</skos:altLabel>
