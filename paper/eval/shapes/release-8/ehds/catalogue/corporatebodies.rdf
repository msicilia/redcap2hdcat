      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/UNO"/>
      <skos:prefLabel xml:lang="en">United Nations Committee on Crime Prevention and Control</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Комитет на ООН за криминална превенция и контрол</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Comité des Nations unies pour la prévention du crime et la lutte contre la délinquance</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Comité das Nações Unidas para a Prevenção e o Controlo do Crime</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Comisión de las Naciones Unidas sobre Prevención y Control</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kumitat tan-Nazzjonijiet Uniti għall-Prevenzjoni tal-Kriminalità u l-Kontroll</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">YK:n rikosten torjuntaa ja valvontaa käsittelevä toimikunta</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Ühinenud Rahvaste Organisatsiooni kuriteoennetuse ja kontrolli komisjon</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Apvienoto Nāciju Organizācijas Noziedzības novēršanas un kontroles komiteja</skos:prefLabel>
      <dc:identifier>UNCCPC</dc:identifier>
      <atold:op-code>UNCCPC</atold:op-code>
      <at:op-code>UNCCPC</at:op-code>
      <at:start.use>1971-06-20</at:start.use>
      <at:authority-code>UNCCPC</at:authority-code>
      <at:end.use>1992-02-05</at:end.use>
      <skos:altLabel xml:lang="de">Auschuss für Verbrechensverhütung und -bekämpfung</skos:altLabel>
      <skos:altLabel xml:lang="es">Comité de Prevención del Delito y Lucha contra la Delincuencia</skos:altLabel>
      <skos:altLabel xml:lang="fr">Comité pour la prévention du crime et la lutte contre la délinquance</skos:altLabel>
      <skos:altLabel xml:lang="en">Committee on Crime Prevention and Control</skos:altLabel>
      <skos:altLabel xml:lang="it">Comitato per la prevenzione del crimine e della lotte alle delinquenza</skos:altLabel>
      <skos:altLabel xml:lang="da">Komitéen for Forebyggelse af Kriminalitet</skos:altLabel>
      <skos:definition xml:lang="en">The political agreement to establish the Commission derived from a ministerial meeting held in Versailles in 1991. It was preceded by a more technically focussed Committee on Crime Prevention and Control, formed in 1971 to replace an earlier expert advisory committee and tackle a broadened scope of UN interest in criminal justice policy.</skos:definition>
   </skos:Concept>
