      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:definition xml:lang="en">OPEC is a permanent, international organization whose mandate is to coordinate and unify the petroleum policies of its members and to ensure the stabilization of oil markets.</skos:definition>
   </skos:Concept>
