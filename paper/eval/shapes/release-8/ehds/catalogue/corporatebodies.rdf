   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/COU_EUR_CDCULT"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001312</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">COU_EUR_CDCULT</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/COU_EUR"/>
      <skos:prefLabel xml:lang="sl">Usmerjevalni odbor za kulturo</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Steering Committee for Culture</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Comitetul Director pentru Cultură</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kumitat tat-Tmexxija għall-Kultura</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Kultūros iniciatyvinis komitetas</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Comité Diretor da Cultura</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Управителен комитет за култура</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Comité directeur de la culture</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Riadiaci výbor pre kultúru</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Kultūras koordinācijas komiteja</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Kulttuurin johtokomitea</skos:prefLabel>
      <dc:identifier>COU_EUR_CDCULT</dc:identifier>
      <atold:op-code>COU_EUR_CDCULT</atold:op-code>
      <at:op-code>COU_EUR_CDCULT</at:op-code>
      <at:start.use>2002-01-01</at:start.use>
      <at:authority-code>COU_EUR_CDCULT</at:authority-code>
      <at:end.use>2011-12-31</at:end.use>
      <skos:altLabel xml:lang="fr">CDCULT</skos:altLabel>
      <skos:altLabel xml:lang="en">CDCULT</skos:altLabel>
      <skos:definition xml:lang="fr">Le Comité Directeur de la Culture a été créé lorsque le Comité des Ministres a décidé de transformer le Conseil de la coopération culturelle (CDCC) et ses comités spécialisés en quatre comités directeurs : Comité Directeur de l’Education (CDED), Comité Directeur de l’Enseignement Supérieur et de la Recherche (CDESR), Comité Directeur de la Culture (CDCULT), Comité Directeur du Patrimoine Culturel (CDPAT).</skos:definition>
      <skos:definition xml:lang="en">The Steering Committee for Culture was established in 2001 when the Committee of Ministers decided to transform the Council for Cultural Cooperation (CDCC) and its specialised committees into four steering committees: Steering Committee for Education (CDED), Steering Committee for Higher Education and Research (CDESR), Steering Committee for Culture (CDCULT), Steering Committee for Cultural Heritage (CDPAT).</skos:definition>
   </skos:Concept>
