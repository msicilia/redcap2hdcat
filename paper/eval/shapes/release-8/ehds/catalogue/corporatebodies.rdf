      <skos:altLabel xml:lang="cs">Andské společenství národů</skos:altLabel>
      <skos:altLabel xml:lang="el">Κοινότητα των εθνών των Άνδεων</skos:altLabel>
      <skos:altLabel xml:lang="sk">Andské spoločenstvo národov</skos:altLabel>
