   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS10"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FD_050">10EM</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS10</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000330</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="fi">Kymmenen jäsenvaltiota: Belgia, Tanska, Saksa, Irlanti, Kreikka, Ranska, Italia, Luxemburg, Alankomaat, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">De tio medlemsstaterna: Belgien, Danmark, Tyskland, Irland, Grekland, Frankrike, Italien, Luxemburg, Nederländerna, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Desať členských štátov: Belgicko, Dánsko, Nemecko, Írsko, Grécko, Francúzsko, Taliansko, Luxembursko, Holandsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Cele zece state membre: Belgia, Danemarca, Germania, Irlanda, Grecia, Franţa, Italia, Luxemburg, Ţările de Jos, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Na Deich mBallstát: an Bheilg, an Danmhairg, an Ghearmáin, Éire, an Ghréig, an Fhrainc, an Iodáil, Lucsamburg, an Ísiltír, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Os dez Estados-Membros: Bélgica, Dinamarca, Alemanha, Irlanda, Grécia, França, Itália, Luxemburgo, Países Baixos, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="en">The ten Member States: Belgium, Denmark, Germany, Ireland, Greece, France, Italy, Luxembourg, Netherlands, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Les dix États membres: Belgique, Danemark, Allemagne, Irlande, Grèce, France, Italie, Luxembourg, Pays-Bas, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Dziesięć państw członkowskich: Belgia, Dania, Niemcy, Irlandia, Grecja, Francja, Włochy, Luksemburg, Niderlandy, Zjednoczone Królestwo</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De ti medlemsstater: Belgien, Danmark, Tyskland, Irland, Grækenland, Frankrig, Italien, Luxembourg, Nederlandene, Det Forenede Kongerige</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τα δέκα κράτη μέλη: Βέλγιο, Δανία, Γερμανία, Ιρλανδία, Ελλάδα, Γαλλία, Ιταλία, Λουξεμβούργο, Κάτω Χώρες, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Deset držav članic: Belgija, Danska, Nemčija, Irska, Grčija, Francija, Italija, Luksemburg, Nizozemska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Десетте държави-членки: Белгия, Дания, Германия, Ирландия, Гърция, Франция, Италия, Люксембург, Нидерландия, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Die zehn Mitgliedstaaten: Belgien, Dänemark, Deutschland, Irland, Griechenland, Frankreich, Italien, Luxemburg, Niederlande, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">I-għaxar Stati Membri: il-Belġju, id-Danimarka, il-Ġermanja, l-Irlanda, il-Greċja, Franza, l-Italja, il-Lussemburgu, il-Pajjiżi l-Baxxi, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Dešimt valstybių narių: Belgija, Danija, Vokietija, Airija, Graikija, Prancūzija, Italija, Liuksemburgas, Nyderlandai, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Kümme liikmesriiki: Belgia, Taani, Saksamaa, Iirimaa, Kreeka, Prantsusmaa, Itaalia, Luksemburg, Madalmaad, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Desmit dalībvalstis: Beļģija, Dānija, Vācija, Īrija, Grieķija, Francija, Itālija, Luksemburga, Nīderlande, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Deset država članica: Belgija, Danska, Njemačka, Irska, Grčka, Francuska, Italija, Luksemburg, Nizozemska, Ujedinjena Kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">A tíz tagállam: Belgium, Dánia, Németország, Írország, Görögország, Franciaország, Olaszország, Luxemburg, Hollandia, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="it">I dieci Stati membri: Belgio, Danimarca, Germania, Irlanda, Grecia, Francia, Italia, Lussemburgo, Paesi Bassi, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Los diez Estados miembros: Bélgica, Dinamarca, Alemania, Irlanda, Grecia, Francia, Italia, Luxemburgo, Países Bajos, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Deset členských států: Belgie, Dánsko, Německo, Irsko, Řecko, Francie, Itálie, Lucembursko, Nizozemsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">De tien lidstaten: België, Denemarken, Duitsland, Ierland, Griekenland, Frankrijk, Italië, Luxemburg, Nederland, Verenigd Koninkrijk</skos:prefLabel>
      <dc:identifier>EUMS10</dc:identifier>
