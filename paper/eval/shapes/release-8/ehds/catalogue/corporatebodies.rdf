   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_EURO13"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000342</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_EURO13</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="it">I Stati membri che hanno adottato l’euro: Belgio, Germania, Irlanda, Grecia, Spagna, Francia, Italia, Lussemburgo, Paesi Bassi, Austria, Portogallo, Slovenia, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Los Estados miembros que han adoptado el euro: Bélgica, Alemania, Irlanda, Grecia, España, Francia, Italia, Luxemburgo, Países Bajos, Austria, Portugal, Eslovenia, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Statele membre care au adoptat euro: Belgia, Germania, Irlanda, Grecia, Spania, Franţa, Italia, Luxemburg, Ţările de Jos, Austria, Portugalia, Slovenia, Finlanda</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras ir ieviesušas euro: Beļģija, Vācija, Īrija, Grieķija, Spānija, Francija, Itālija, Luksemburga, Nīderlande, Austrija, Portugāle, Slovēnija, Somija</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Valstybės narės, įsivedusios eurą: Belgija, Vokietija, Airija, Graikija, Ispanija, Prancūzija, Italija, Liuksemburgas, Nyderlandai, Austrija, Portugalija, Slovėnija, Suomija</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Na Ballstáit a ghlac leis an euro: an Bheilg, an Ghearmáin, Éire, an Ghréig, an Spáinn, an Fhrainc, an Iodáil, Lucsamburg, an Ísiltír, an Ostair, an Phortaingéil, an tSlóivéin, an Fhionlainn</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τα κράτη μέλη που υιοθέτησαν το ευρώ: Βέλγιο, Γερμανία, Ιρλανδία, Ελλάδα, Ισπανία, Γαλλία, Ιταλία, Λουξεμβούργο, Κάτω Χώρες, Αυστρία, Πορτογαλία, Σλοβενία, Φινλανδία</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy, které přijaly euro: Belgie, Německo, Irsko, Řecko, Španělsko, Francie, Itálie, Lucembursko, Nizozemsko, Rakousko, Portugalsko, Slovinsko, Finsko</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euro kasutusele võtnud liikmesriigid: Belgia, Saksamaa, Iirimaa, Kreeka, Hispaania, Prantsusmaa, Itaalia, Luksemburg, Madalmaad, Austria, Portugal, Sloveenia, Soome</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Jäsenvaltiot, jotka ovat ottaneet käyttöön euron: Belgia, Saksa, Irlanti, Kreikka, Espanja, Ranska, Italia, Luxemburg, Alankomaat, Itävalta, Portugali, Slovenia, Suomi</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">De lidstaten die de euro hebben aangenomen: België, Duitsland, Ierland, Griekenland, Spanje, Frankrijk, Italië, Luxemburg, Nederland, Oostenrijk, Portugal, Slovenië, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави-членки, които са приели еврото: Белгия, Германия, Ирландия, Гърция, Испания, Франция, Италия, Люксембург, Австрия, Нидерландия, Португалия, Словения, Финландия</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De medlemsstater, der har indført euroen: Belgien, Tyskland, Irland, Grækenland, Spanien, Frankrig, Italien, Luxembourg, Nederlandene, Østrig, Portugal, Slovenien, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Os Estados-Membros que adoptaram o euro: Bélgica, Alemanha, Irlanda, Grécia, Espanha, França, Itália, Luxemburgo, Países Baixos, Áustria, Portugal, Eslovénia, Finlândia</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">De medlemsstater som har infört euron: Belgien, Tyskland, Irland, Grekland, Spanien, Frankrike, Italien, Luxemburg, Nederländerna, Österrike, Portugal, Slovenien, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členské štáty, ktoré prijali euro: Belgicko, Nemecko, Írsko, Grécko, Španielsko, Francúzsko, Taliansko, Luxembursko, Holandsko, Rakúsko, Portugalsko, Slovinsko, Fínsko</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres ayant adopté l’euro: Belgique, Allemagne, Irlande, Grèce, Espagne, France, Italie, Luxembourg, Pays-Bas, Autriche, Portugal, Slovénie, Finlande</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Az eurót bevezető tagállamok: Belgium, Németország, Írország, Görögország, Spanyolország, Franciaország, Olaszország, Luxemburg, Hollandia, Ausztria, Portugália, Szlovénia, Finnország</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri wara li adottaw l-euro: il-Belġju, il-Ġermanja, l-Irlanda, il-Greċja, Spanja, Franza, l-Italja, il-Lussemburgu, il-Pajjiżi l-Baxxi, l-Awstrija, il-Portugall, is-Slovenja, il-Finlandja</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki so sprejele euro: Belgija, Nemčija, Irska, Grčija, Španija, Francija, Italija, Luksemburg, Nizozemska, Avstrija, Portugalska, Slovenija, Finska</skos:prefLabel>
      <skos:prefLabel xml:lang="en">The Member States having adopted the euro: Belgium, Germany, Ireland, Greece, Spain, France, Italy, Luxembourg, Netherlands, Austria, Portugal, Slovenia, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice koje su prihvatile euro: Belgija, Njemačka, Irska, Grčka, Španjolska, Francuska, Italija, Luksemburg, Nizozemska, Austrija, Portugal, Slovenija, Finska</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwa członkowskie, które przyjęły walutę euro: Belgia, Niemcy, Irlandia, Grecja, Hiszpania, Francja, Włochy, Luksemburg, Niderlandy, Austria, Portugalia, Słowenia, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Die Mitgliedstaaten, die den Euro eingeführt haben: Belgien, Deutschland, Irland, Griechenland, Spanien, Frankreich, Italien, Luxemburg, Niederlande, Österreich, Portugal, Slowenien, Finland</skos:prefLabel>
      <dc:identifier>EUMS_EURO13</dc:identifier>
      <atold:op-code>EUMS_EURO13</atold:op-code>
      <at:op-code>EUMS_EURO13</at:op-code>
      <at:start.use>2007-01-01</at:start.use>
      <at:authority-code>EUMS_EURO13</at:authority-code>
      <at:end.use>2007-12-31</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/BANK_EURO11"
                 at:deprecated="true">
