         <at:MappedCode>
            <dc:source>EurLex</dc:source>
            <at:affected-table>FD_050</at:affected-table>
            <at:legacy-code>9EM</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
   </skos:Concept>
