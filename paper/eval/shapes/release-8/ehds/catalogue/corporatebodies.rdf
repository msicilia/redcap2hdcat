   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EP_CODE"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#EP">CODE</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EP_CODE</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#EP">LEGI</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001660</skos:notation>
