   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_NONEURO12"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_NONEURO12</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000349</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="pl">Państwo członkowskie spoza strefy euro: Bułgaria, Republika Czeska, Dania, Estonia, Łotwa, Litwa, Węgry, Polska, Rumunia, Słowacja, Szwecja, Zjednoczone Królestwo</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">State membre din afara zonei euro: Bulgaria, Republica Cehă, Danemarca, Estonia, Letonia, Lituania, Ungaria, Polonia, România, Slovacia, Suedia, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroalueen ulkopuoliset jäsenvaltiot: Bulgaria, Tšekki, Tanska, Viro, Latvia, Liettua, Unkari, Puola, Romania, Slovakia, Ruotsi, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κράτη μέλη εκτός ζώνης ευρώ: Βουλγαρία, Τσεχική Δημοκρατία, Δανία, Εσθονία, Λετονία, Λιθουανία, Ουγγαρία, Πολωνία, Ρουμανία, Σλοβακία, Σουηδία, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Estados miembros no pertenecientes a la zona del euro: Bulgaria, Chequia, Dinamarca, Estonia, Letonia, Lituania, Hungría, Polonia, Rumanía, Eslovaquia, Suecia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Euro zonai nepriklausančios valstybės narės: Bulgarija, Čekijos Respublika, Danija, Estija, Latvija, Lietuva, Vengrija, Lenkija, Rumunija, Slovakija, Švedija, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Estados-Membros não participante na área do euro: Bulgária, República Checa, Dinamarca, Estónia, Letónia, Lituânia, Hungria, Polónia, Roménia, Eslováquia, Suécia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Stati membri non appartenenti all’area dell’euro: Bulgaria, Repubblica Ceca, Danimarca, Estonia, Lettonia, Lituania, Ungheria, Polonia, Romania, Slovacchia, Svezia, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Non-euro area Member States: Bulgaria, Czech Republic, Denmark, Estonia, Latvia, Lithuania, Hungary, Poland, Romania, Slovakia, Sweden, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Lidstaten buiten de eurozone: Bulgarije, Tsjechische Republiek, Denemarken, Estland, Letland, Litouwen, Hongarije, Polen, Roemenië, Slowakije, Zweden, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy mimo eurozónu: Bulharsko, Česká republika, Dánsko, Estonsko, Lotyšsko, Litva, Maďarsko, Polsko, Rumunsko, Slovensko, Švédsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres n’appartenant pas à la zone euro: Bulgarie, République tchèque, Danemark, Estonie, Lettonie, Lituanie, Hongrie, Pologne, Roumanie, Slovaquie, Suède, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroalasse mittekuuluvad liikmesriigid: Bulgaaria, Tšehhi Vabariik, Taani, Eesti, Läti, Leedu, Ungari, Poola, Rumeenia, Slovakkia, Rootsi, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави-членки извън еврозоната: България, Чешката република, Дания, Естония, Латвия, Литва, Унгария, Полша, Румъния, Словакия, Швеция, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Euróövezeten kívüli tagállamok: Bulgária, Cseh Köztársaság, Dánia, Észtország, Lettország, Litvánia, Magyarország, Lengyelország, Románia, Szlovákia, Svédország, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ballstáit nach bhfuil sa limistéar euro: an Bhulgáir, Poblacht na Seice, an Danmhairg, an Eastóin, an Laitvia, an Liotuáin, an Ungáir, an Pholainn, an Rómáin, an tSlóvaic, an tSualainn, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki niso v euroobmočju: Bolgarija, Češka, Danska, Estonija, Latvija, Litva, Madžarska, Poljska, Romunija, Slovaška, Švedska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Medlemsstater utanför euroområdet: Bulgarien, Tjeckien, Danmark, Estland, Lettland, Litauen, Ungern, Polen, Rumänien, Slovakien, Sverige, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras nav ieviesušas euro: Bulgārija, Čehijas Republika, Dānija, Igaunija, Latvija, Lietuva, Ungārija, Polija, Rumānija, Slovēnija, Slovākija, Zviedrija, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri mhux fiż-żona tal-euro: il-Bulgarija, ir-Repubblika Ċeka, id-Danimarka, l-Estonja, il-Latvja, il-Litwanja, l-Ungerija, il-Polonja, ir-Rumanija, is-Slovakkja, l-Isvezja, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nicht dem Euro-Währungsgebiet angehörende Mitgliedstaaten: Bulgarien, Tschechische Republik, Dänemark, Estland, Lettland, Litauen, Ungarn, Polen, Rumänien, Slowakei, Schweden, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členský štát, ktorý nie je krajinou eurozóny: Bulharsko, Česká republika, Dánsko, Estónsko, Lotyšsko, Litva, Maďarsko, Poľsko, Rumunsko, Slovinsko, Švédsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice izvan europodručja: Bugarska, Češka, Danska, Estonija, Latvija, Litva, Mađarska, Poljska, Rumunjska, Slovačka, Švedska, Ujedinjena kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Medlemsstater uden for Euroområdet: Bulgarien, Den Tjekkiske Republik, Danmark, Estland, Letland, Litauen, Ungarn, Polen, Rumænien, Slovakiet, Sverige, Det Forenede Kongerige</skos:prefLabel>
      <dc:identifier>EUMS_NONEURO12</dc:identifier>
