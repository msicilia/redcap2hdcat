      <dc:identifier>UNSOCCOM</dc:identifier>
      <atold:op-code>UNSOCCOM</atold:op-code>
      <at:op-code>UNSOCCOM</at:op-code>
      <at:start.use>1946-06-21</at:start.use>
      <at:authority-code>UNSOCCOM</at:authority-code>
      <at:end.use>1966-07-28</at:end.use>
      <skos:altLabel xml:lang="de">Sozialkommission</skos:altLabel>
      <skos:altLabel xml:lang="en">Social Commission</skos:altLabel>
      <skos:definition xml:lang="en">The Social Commission was established by ECOSOC res. 10 (II) (1946). Its purpose was to advise ECOSOC on social policies of a general character and, in particular, on all matters in the social field not covered by the specialised inter-governmental agencies.</skos:definition>
   </skos:Concept>
