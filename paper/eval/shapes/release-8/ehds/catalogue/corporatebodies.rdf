   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_NONEURO13"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000695</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_NONEURO13</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="en">Non-euro area Member States: Czech Republic, Denmark, Estonia, Cyprus, Latvia, Lithuania, Hungary, Malta, Poland, Slovenia, Slovakia, Sweden, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členské štáty, ktoré nepatria do eurozóny: Česká republika, Dánsko, Estónsko, Cyprus, Lotyšsko, Litva, Maďarsko, Malta, Poľsko, Slovinsko, Slovensko, Švédsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ballstáit nach bhfuil sa limistéar euro: Poblacht na Seice, an Danmhairg, an Eastóin, an Chipir, an Laitvia, an Liotuáin, an Ungáir, Málta, an Pholainn, An tSlóivéin, an tSlóvaic, an tSualainn, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κράτη μέλη εκτός ζώνης ευρώ: Τσεχική Δημοκρατία, Δανία, Εσθονία, Κύπρος, Λετονία, Λιθουανία, Ουγγαρία, Μάλτα, Πολωνία, Σλοβενία, Σλοβακία, Σουηδία, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави членки извън еврозоната: Чешката република, Дания, Естония, Кипър, Латвия, Литва, Унгария, Малта, Полша, Словения, Словакия, Швеция, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Medlemsstater utanför euroområdet: Tjeckien, Danmark, Estland, Cypern, Lettland, Litauen, Ungern, Malta, Polen, Slovenien, Slovakien, Sverige, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Euróövezeten kívüli tagállamok: Cseh Köztársaság, Dánia, Észtország, Ciprus, Lettország, Litvánia, Magyarország, Málta, Lengyelország, Szlovénia, Szlovákia, Svédország, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Euro zonai nepriklausančios valstybės narės: Čekijos Respublika, Danija, Estija, Kipras, Latvija, Lietuva, Vengrija, Malta, Lenkija, Slovėnija, Slovakija, Švedija, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">State membre din afara zonei euro: Republica Cehă, Danemarca, Estonia, Cipru, Letonia, Lituania, Ungaria, Malta, Polonia, Slovenia, Slovacia, Suedia, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Lidstaten buiten de eurozone: Tsjechië, Denemarken, Estland, Cyprus, Letland, Litouwen, Hongarije, Malta, Polen, Slovenië, Slowakije, Zweden, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nicht dem Euro-Währungsgebiet angehörende Mitgliedstaaten: Tschechische Republik, Dänemark, Estland, Zypern, Lettland, Litauen, Ungarn, Malta, Polen, Slowenien, Slowakei, Schweden, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki niso v euroobmočju: Češka, Danska, Estonija, Ciper, Latvija, Litva, Madžarska, Malta, Poljska, Slovenija, Slovaška, Švedska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice izvan europodručja: Češka, Danska, Estonija, Cipar, Latvija, Litva, Mađarska, Malta, Poljska, Slovenija, Slovačka, Švedska, Ujedinjena Kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras nav eurozonas dalībnieces: Čehijas Republika, Dānija, Igaunija, Kipra, Latvija, Lietuva, Ungārija, Malta, Polija, Slovēnija, Slovākija, Zviedrija, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri mhux fiż-żona tal-euro: ir-Repubblika Ċeka, id-Danimarka, l-Estonja, Ċipru, il-Latvja, il-Litwanja, l-Ungerija, Malta, il-Polonja, is-Slovenja, is-Slovakkja, l-Isvezja, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroalueen ulkopuoliset jäsenvaltiot: Tšekki, Tanska, Viro, Kypros, Latvia, Liettua, Unkari, Malta, Puola, Slovenia, Slovakia, Ruotsi, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Estados-Membros não participantes na área do euro: República Checa, Dinamarca, Estónia, Chipre, Letónia, Lituânia, Hungria, Malta, Polónia, Eslovénia, Eslováquia, Suécia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres n’appartenant pas à la zone euro: République tchèque, Danemark, Estonie, Chypre, Lettonie, Lituanie, Hongrie, Malte, Pologne, Slovénie, Slovaquie, Suède, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Medlemsstater uden for Euroområdet: Den Tjekkiske Republik, Danmark, Estland, Cypern, Letland, Litauen, Ungarn, Malta, Polen, Slovenien, Slovakiet, Sverige, Det Forenede Kongerige</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Stati membri non appartenenti all’area dell’euro: Repubblica ceca, Danimarca, Estonia, Cipro, Lettonia, Lituania, Ungheria, Malta, Polonia, Slovenia, Slovacchia, Svezia, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroalasse mittekuuluvad liikmesriigid: Tšehhi Vabariik, Taani, Eesti, Küpros, Läti, Leedu, Ungari, Malta, Poola, Sloveenia, Slovakkia, Rootsi, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Estados miembros no pertenecientes a la zona del euro: Chequia, Dinamarca, Estonia, Chipre, Letonia, Lituania, Hungría, Malta, Polonia, Eslovenia, Eslovaquia, Suecia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy mimo eurozónu: Česká republika, Dánsko, Estonsko, Kypr, Lotyšsko, Litva, Maďarsko, Malta, Polsko, Slovinsko, Slovensko, Švédsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwa członkowskie spoza strefy euro: Republika Czeska, Dania, Estonia, Cypr, Łotwa, Litwa, Węgry, Malta, Polska, Słowenia, Słowacja, Szwecja, Zjednoczone Królestwo</skos:prefLabel>
      <dc:identifier>EUMS_NONEURO13</dc:identifier>
      <atold:op-code>EUMS_NONEURO13</atold:op-code>
      <at:op-code>EUMS_NONEURO13</at:op-code>
