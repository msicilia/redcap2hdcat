      <skos:altLabel xml:lang="en">ETUC</skos:altLabel>
      <skos:altLabel xml:lang="nl">EVV</skos:altLabel>
      <skos:altLabel xml:lang="mt">KETU</skos:altLabel>
      <skos:altLabel xml:lang="pt">CES</skos:altLabel>
      <skos:altLabel xml:lang="fr">CES</skos:altLabel>
