      <skos:altLabel xml:lang="mt">CARIFORUM</skos:altLabel>
      <skos:altLabel xml:lang="ga">CARIFORUM</skos:altLabel>
      <skos:altLabel xml:lang="hu">CARIFORUM</skos:altLabel>
      <skos:altLabel xml:lang="hu">Az afrikai, karibi és csendes-óceáni államok karibi csoportjának fóruma</skos:altLabel>
      <skos:altLabel xml:lang="cs">Fórum karibské skupiny afrických, karibských a tichomořských států (AKT)</skos:altLabel>
      <skos:altLabel xml:lang="ro">CARIFORUM</skos:altLabel>
