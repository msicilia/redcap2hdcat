            <dc:source>WHOISWHO</dc:source>
            <at:legacy-code>ECCC</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">The European Cybersecurity Industrial, Technology and Research Competence Centre (ECCC) is an agency of the European Union tasked with funding and coordinating cybersecurity research projects. The ECCC collaborates closely with the Network of National Coordination Centres.</skos:definition>
   </skos:Concept>
