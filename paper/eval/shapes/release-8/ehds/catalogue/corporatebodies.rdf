      <skos:altLabel xml:lang="en">BEUC</skos:altLabel>
      <skos:altLabel xml:lang="cs">BEUC</skos:altLabel>
      <skos:altLabel xml:lang="sk">BEUC</skos:altLabel>
      <skos:altLabel xml:lang="de">BEUC</skos:altLabel>
      <skos:altLabel xml:lang="fi">BEUC</skos:altLabel>
      <skos:altLabel xml:lang="lv">BEUC</skos:altLabel>
      <skos:altLabel xml:lang="et">BEUC</skos:altLabel>
      <skos:altLabel xml:lang="pt">BEUC</skos:altLabel>
      <skos:exactMatch rdf:resource="http://eurovoc.europa.eu/4859"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:definition xml:lang="fr">Le BEUC a été fondé par les organisations de consommateurs de 6 États membres de ce qui s’appelait alors la Communauté économique européenne. Regroupant plus de 40 organisations membres issues de 31 pays européens, BEUC est une organisation non gouvernementale dont le travail consiste à faire entendre la voix des consommateurs européens auprès des institutions de l’Union européenne que sont la Commission, le Parlement et le Conseil.</skos:definition>
      <skos:definition xml:lang="en">BEUC was founded by consumer organisations from 6 Member States of what was then the European Economic Community. Comprised of more than 40 member organisations from 30-plus European countries, BEUC is a non-governmental organisation whose job it is to bring the voice of Europe’s consumers to the European Union legislative institutions of Commission, Parliament and Council.</skos:definition>
   </skos:Concept>
