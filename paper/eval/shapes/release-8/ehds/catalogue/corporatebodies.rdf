      <skos:prefLabel xml:lang="sl">Latinskoameriški in karibski gospodarski sistem</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Hospodársky systém Latinskej Ameriky a Karibiku</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Latinamerikanska och karibiska ekonomiska systemet</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Латиноамериканска и карибска икономическа система</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Système économique latino-américain et des Caraïbes</skos:prefLabel>
      <dc:identifier>LACES</dc:identifier>
      <atold:op-code>LACES</atold:op-code>
