      <skos:prefLabel xml:lang="et">Ladina-Ameerika ja Kariibi mere riikide majandussüsteem</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Latijns-Amerikaans en Caribisch economisch systeem</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Latinalaisen Amerikan ja Karibian talousjärjestelmä</skos:prefLabel>
