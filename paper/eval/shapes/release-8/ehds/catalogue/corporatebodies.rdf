      <atold:op-code>IFLA</atold:op-code>
      <at:op-code>IFLA</at:op-code>
      <at:start.use>1976-08-23</at:start.use>
      <at:authority-code>IFLA</at:authority-code>
      <skos:altLabel xml:lang="en">IFLA</skos:altLabel>
      <skos:altLabel xml:lang="fr">IFLA</skos:altLabel>
      <skos:altLabel xml:lang="sv">IFLA</skos:altLabel>
