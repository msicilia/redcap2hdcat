      <skos:exactMatch rdf:resource="http://eurovoc.europa.eu/3853"/>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>EurLex</dc:source>
            <at:affected-table>FD_050</at:affected-table>
            <at:legacy-code>IATA</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:definition xml:lang="en">The International Air Transport Association (IATA) works with its airline members and the air transport industry as a whole to promote safe, reliable, secure and economical air travel for the benefit of the world’s consumers. IATA sets standards in many areas of the business – from ticketing to baggage – that make it possible for passengers to travel from one place to another using two or more airlines. It also leads a number of industry initiatives involving safety, security, environment and the quality of air travel.</skos:definition>
   </skos:Concept>
