      <skos:prefLabel xml:lang="es">Fondo de Solidaridad para la Movilidad de los Jóvenes</skos:prefLabel>
      <skos:prefLabel xml:lang="sr">Фонд солидарности за мобилност омладине</skos:prefLabel>
