      <skos:prefLabel xml:lang="sk">Riadiaci výbor pre kultúru, dedičstvo a krajinu</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Comitetul director pentru cultură, patrimoniu și peisaj</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Comité directeur de la culture, du patrimoine et du paysage</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Koordinācijas komiteja kultūras, kultūras mantojuma un ainavu jomā</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Komitet Sterujący ds. Kultury, Dziedzictwa Kulturowego i Krajobrazu</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Řídící výbor pro kulturu, kulturní dědictví a krajinu</skos:prefLabel>
