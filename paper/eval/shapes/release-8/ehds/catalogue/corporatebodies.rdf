      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001688</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/CONSIL"/>
      <skos:prefLabel xml:lang="lv">Atmežošanas un mežu degradācijas riska, kas saistīts ar ES tirgū laistiem produktiem, ad hoc darba grupa</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Grupa robocza ad hoc ds. ryzyka wylesiania i degradacji lasów związanej z produktami wprowadzanymi do obrotu na rynku UE</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">EU:n markkinoille saatettuihin tuotteisiin liittyvän metsäkadon ja metsien tilan heikkenemisen riskiä käsittelevä ad hoc -työryhmä</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Groupe ad hoc sur le risque de déforestation et de dégradation des forêts associé aux produits mis sur le marché de l’UE</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Ad-Hoc-Gruppen vedrørende Risikoen for Skovrydning og Skovforringelse i forbindelse med Produkter, der Markedsføres i EU</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Pracovná skupina ad hoc pre riziko odlesňovania a degradácie lesov v súvislosti s výrobkami uvádzanými na trh eú</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Ajutine ELi turule lastud toodetega seotud raadamise ja metsade degradeerumise riski töörühm</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Miškų naikinimo ir alinimo, siejamo su ES rinkai teikiamais produktais, rizikos klausimų ad hoc darbo grupė</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Az uniós piacon forgalomba hozott termékekhez kapcsolódó erdőirtás és erdőpusztulás kockázatával foglalkozó ad hoc munkacsoport</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Ad hoc delovna skupina za zmanjšanje tveganja za krčenje in degradacijo gozdov, ki sta povezana z izdelki, danimi na trg EU</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Grupo ad hoc «Riesgo de Deforestación y Degradación de los Bosques asociada a Productos Comercializados en la UE»</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Grupo ad hoc sobre o risco de desflorestação e de degradação florestal associado aos produtos colocados no mercado da UE</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Ad hoc pracovní skupina pro riziko odlesňování a znehodnocování lesů spojeného s produkty uváděnými na trh EU</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ad-hoc-Gruppe „Risiko von Entwaldung und Waldschädigung im Zusammenhang mit Produkten, die in der EU in Verkehr gebracht werden“</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Ad hoc-gruppen för risken för avskogning och skogsförstörelse i samband med produkter som släpps ut på EU-marknaden</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Gruppo ad hoc «Rischio di deforestazione e degrado forestale associato ai prodotti immessi sul mercato dell’UE»Gruppo ad hoc DF)</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Grupp ta’ Ħidma ad hoc dwar ir-riskju ta’ deforestazzjoni u degradazzjoni tal-foresti assoċjat ma’ prodotti mqiegħda fis-suq tal-UE</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Работна група ad hoc „Риск от обезлесяване и влошаване на състоянието на горите, свързани с продукти, пуснати на пазара на ЕС“</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Prijedlog uredbe o smanjenju rizika od krčenja šuma i njihova propadanja povezanog s proizvodima koji se stavljaju na tržište EU-a</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Ad hoc Working Party on the risk of deforestation and forest degradation associated with products placed on the EU market</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Grupul de lucru ad-hoc pentru problema riscului de defrișare și de degradare a pădurilor asociat produselor introduse pe piața UE</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Ad-hocgroep risico op ontbossing en bosdegradatie in verband met producten die in de EU op de markt worden gebracht</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Ad hoc Ομάδα για τον κίνδυνο αποψίλωσης και υποβάθμισης των δασών σε σχέση με τα προϊόντα που διατίθενται στην αγορά της ΕΕ</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">An Mheitheal ad hoc um riosca an dífhoraoisithe agus an díghrádaithe foraoise a bhaineann le táirgí a chuirtear ar mhargadh an Aontais a íoslaghdú</skos:prefLabel>
      <dc:identifier>AHWP_DF</dc:identifier>
      <atold:op-code>AHWP_DF</atold:op-code>
      <at:op-code>AHWP_DF</at:op-code>
      <at:start.use>2009-12-01</at:start.use>
      <at:authority-code>AHWP_DF</at:authority-code>
      <at:end.use>2023-07-06</at:end.use>
      <skos:altLabel xml:lang="fr">Groupe ad hoc sur la déforestation importée</skos:altLabel>
