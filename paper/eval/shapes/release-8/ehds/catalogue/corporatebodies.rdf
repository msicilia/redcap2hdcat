      <skos:exactMatch rdf:resource="http://eurovoc.europa.eu/7417"/>
      <skos:definition xml:lang="en">Permanent representations are diplomatic bodies accredited to the European Union institutions, not to countries. Each EU Member State has a permanent representation in Brussels.</skos:definition>
   </skos:Concept>
