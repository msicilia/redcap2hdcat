      <at:authority-code>EPPO</at:authority-code>
      <skos:altLabel xml:lang="en">EPPO</skos:altLabel>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>PUB</dc:source>
            <at:affected-table>PUB_CORP</at:affected-table>
            <at:legacy-code>EPPO</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <skos:definition xml:lang="en">The EPPO is an independent Union body with the authority to investigate and prosecute EU-fraud and other crimes affecting the Union’s financial interests. It combines European and national law-enforcement efforts in a unified, seamless and efficient approach to counter EU-fraud.</skos:definition>
   </skos:Concept>
