      <skos:prefLabel xml:lang="sk">Poradný výbor pre bezpečnosť a ochranu zdravia pri práci</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Darbuotojų saugos ir sveikatos patariamasis komitetas</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Työturvallisuuden ja työterveyden neuvoa-antava komitea</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Beratender Ausschuss für Sicherheit und Gesundheit am Arbeitsplatz</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Advisory Committee on Safety and Health at Work</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Raadgevend Comité voor veiligheid en gezondheid op de arbeidsplaats</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Svetovalni odbor za varnost in zdravje pri delu</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Det Rådgivende Udvalg for Sikkerhed og Sundhed på Arbejdspladsen</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kumitat ta’ Konsulenza dwar is-Sigurtà u s-Saħħa fuq il-Post tax-Xogħol</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Komitet Doradczy ds. Bezpieczeństwa i Ochrony Zdrowia w Miejscu Pracy</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Tööohutuse ja töötervishoiu nõuandekomitee</skos:prefLabel>
