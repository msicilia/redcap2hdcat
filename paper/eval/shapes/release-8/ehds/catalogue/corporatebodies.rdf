      <skos:altLabel xml:lang="pl">Komisja tymczasowa (BSE)</skos:altLabel>
      <skos:altLabel xml:lang="it">Commissione temporanea (ESB)</skos:altLabel>
      <skos:altLabel xml:lang="cs">Dočasný výbor (BSE)</skos:altLabel>
      <skos:altLabel xml:lang="lv">Pagaidu komisija (BSE)</skos:altLabel>
