   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/WP_COELA"
                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">WP_COELA</skos:notation>
