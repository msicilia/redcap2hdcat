      <skos:altLabel xml:lang="bg">UPU</skos:altLabel>
      <skos:altLabel xml:lang="mt">UPU</skos:altLabel>
      <skos:altLabel xml:lang="en">UPU</skos:altLabel>
      <skos:altLabel xml:lang="hu">UPU</skos:altLabel>
      <skos:altLabel xml:lang="nl">UPU</skos:altLabel>
