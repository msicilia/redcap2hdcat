      <skos:altLabel xml:lang="el">ΥΑ</skos:altLabel>
      <skos:altLabel xml:lang="fr">HCDH</skos:altLabel>
      <skos:altLabel xml:lang="el">Υπατη Αρμοστεία των Ηνωμένων Εθνών για τα ανθρώπινα δικαιώματα</skos:altLabel>
      <skos:altLabel xml:lang="pt">Alto Comissariado das Nações Unidas para os Direitos do Homem</skos:altLabel>
