   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_NONEURO4"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_NONEURO4</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000346</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="mt">L-Istati Membri mhux fiż-żona tal-euro: id-Danimarka, il-Greċja, l-Isvezja, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres n’appartenant pas à la zone euro: Danemark, Grèce, Suède, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ballstáit nach bhfuil sa limistéar euro: an Danmhairg, an Ghréig, an tSualainn, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroalasse mittekuuluvad liikmesriigid: Taani, Kreeka, Rootsi, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Non-euro area Member States: Denmark, Greece, Sweden, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Medlemsstater utanför euroområdet: Danmark, Grekland, Sverige, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Estados-Membros não participante na área do euro: Dinamarca, Grécia, Suécia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice izvan europodručja: Danska, Grčka, Švedska, Ujedinjena kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави-членки извън еврозоната: Дания, Гърция, Швеция, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Euro zonai nepriklausančios valstybės narės: Danija, Graikija, Švedija, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">State membre din afara zonei euro: Danemarca, Grecia, Suedia, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Euróövezeten kívüli tagállamok: Dánia, Görögország, Svédország, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Medlemsstater uden for Euroområdet: Danmark, Grækenland, Sverige, Det Forenede Kongerige</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki niso v euroobmočju: Danska, Grčija, Švedska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy mimo eurozónu: Dánsko, Řecko, Švédsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členský štát, ktorý nie je krajinou eurozóny: Dánsko, Grécko, Švédsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Lidstaten buiten de eurozone: Denemarken, Griekenland, Zweden, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras nav ieviesušas euro: Dānija, Grieķija, Zviedrija, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nicht dem Euro-Währungsgebiet angehörende Mitgliedstaaten: Dänemark, Griechenland, Schweden, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Stati membri non appartenenti all’area dell’euro: Danimarca, Grecia, Svezia, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroalueen ulkopuoliset jäsenvaltiot: Tanska, Kreikka, Ruotsi, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κράτη μέλη εκτός ζώνης ευρώ: Δανία, Ελλάδα, Σουηδία, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Estados miembros no pertenecientes a la zona del euro: Dinamarca, Grecia, Suecia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwo członkowskie spoza strefy euro: Dania, Grecja, Szwecja, Zjednoczone Królestwo</skos:prefLabel>
      <dc:identifier>EUMS_NONEURO4</dc:identifier>
      <atold:op-code>EUMS_NONEURO4</atold:op-code>
      <at:op-code>EUMS_NONEURO4</at:op-code>
      <at:start.use>1999-01-01</at:start.use>
      <at:authority-code>EUMS_NONEURO4</at:authority-code>
      <at:end.use>2000-12-31</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/GOVREP"
                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">GOVREP</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000353</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="en">Representatives of the Governments of the Member States</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Valstybių narių vyriausybių atstovai</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Predstavnici vlada država članica</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Företrädare för medlemsstaternas regeringar</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Representantes dos Governos dos Estados-Membros</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Представители на правителствата на държавите-членки</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Reprezentanţii guvernelor statelor membre</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Vertreter der Regierungen der Mitgliedstaaten</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Zástupci vlád členských států</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">A tagállamok kormányainak képviselői</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Predstavniki vlad držav članic</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstu valdību pārstāvji</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Εκπρόσωποι των κυβερνήσεων των κρατών μελών</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Ir-Rappreżentanti tal-Gvernijiet tal-Istati Membri</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Zástupcovia vlád členských štátov</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Repræsentanterne for medlemsstaternes regeringer</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Représentants des gouvernements des États membres</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Liikmesriikide valitsuste esindajad</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Przedstawiciele rządów państw członkowskich</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Representantes de los Gobiernos de los Estados Miembros</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Jäsenvaltioiden hallitusten edustajat</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Vertegenwoordigers van de regeringen van de lidstaten</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ionadaithe Rialtais na mBallstát</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Rappresentanti dei Governi degli Stati membri</skos:prefLabel>
      <dc:identifier>GOVREP</dc:identifier>
      <atold:op-code>GOVREP</atold:op-code>
