      <at:authority-code>ELEN</at:authority-code>
      <skos:altLabel xml:lang="en">ELEN</skos:altLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:definition xml:lang="en">The European Language Equality Network (ELEN) is a non-governmental organisation. ELEN has as its goal the promotion and protection of European lesser-used (i.e. regional, minority, endangered, indigenous, co-official and smaller national) languages, to work towards linguistic equality for these languages, and multilingualism, under the broader framework of human rights.</skos:definition>
   </skos:Concept>
