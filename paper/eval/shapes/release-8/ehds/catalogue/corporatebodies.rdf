      <skos:prefLabel xml:lang="da">Det Europæiske finanspolitiske råd</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Europeisk finanspolitisk nämnd</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Ευρωπαϊκό δημοσιονομικό συμβούλιο</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Европейски фискален съвет</skos:prefLabel>
