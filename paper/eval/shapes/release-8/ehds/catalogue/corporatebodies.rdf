      <skos:altLabel xml:lang="nl">Commissie voor de rechten van de mens</skos:altLabel>
      <skos:altLabel xml:lang="en">Commission on Human Rights</skos:altLabel>
      <skos:altLabel xml:lang="bg">Комисия по правата на човека</skos:altLabel>
      <skos:altLabel xml:lang="pt">Comissão dos Direitos do Homem</skos:altLabel>
