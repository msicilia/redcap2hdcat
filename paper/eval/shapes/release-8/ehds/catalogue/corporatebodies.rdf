   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EP_TAXE"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000986</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EP_TAXE</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EP_CMT"/>
      <skos:prefLabel xml:lang="sv">Särskilt utskott för skattebeslut och andra åtgärder av liknande karaktär eller med liknande effekt</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Posebni odbor za odluke o porezima i ostale mjere slične prirode ili učinka</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">A feltételes adómegállapításokkal és jellegükben vagy hatásukban hasonló egyéb intézkedésekkel foglalkozó különbizottság</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kumitat speċjali dwar id-deċiżjonijiet fil-qasam tat-taxxa u miżuri oħra ta’ natura jew effett simili</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Специална комисия относно данъчните постановления и други мерки, сходни по естество или въздействие</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Special Committee on Tax Rulings and Other Measures Similar in Nature or Effect</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Osobitný výbor pre daňové rozhodnutia a ďalšie opatrenia podobného charakteru alebo účinku</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Sonderausschuss zu Steuervorbescheiden und anderen Maßnahmen ähnlicher Art oder Wirkung</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Ειδική επιτροπή σχετικά με τις φορολογικές αποφάσεις τύπου «tax ruling» και άλλα μέτρα παρόμοιου χαρακτήρα ή αποτελέσματος</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Zvláštní výbor pro daňová rozhodnutí a jiná opatření podobná svojí povahou nebo účinkem</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Commission spéciale sur les rescrits fiscaux et autres mesures similaires par leur nature ou par leur effet</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Veropäätöksiä ja muita luonteeltaan tai vaikutuksiltaan samankaltaisia toimenpiteitä käsittelevä erityisvaliokunta</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Det Særlige Udvalg om Afgørelser i Skattespørgsmål og Andre Foranstaltninger af Lignende Art eller med Lignende Virkning</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Posebni odbor za davčne odločbe in druge ukrepe podobne narave ali s podobnim učinkom</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Bijzondere Commissie fiscale rulings en andere maatregelen van vergelijkbare aard of met vergelijkbaar effect</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Coiste Speisialta um Rialuithe Cánach agus Bearta Eile atá Comhchosúil ó thaobh Cineáil nó Éifeachta</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Comisión Especial sobre Resoluciones Fiscales y Otras Medidas de Naturaleza o Efectos Similares</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Komisja Specjalna ds. Interpretacji Prawa Podatkowego i Innych Środków o Podobnym Charakterze lub Skutkach</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Maksualaste siduvate eelotsuste ja samasuguse iseloomuga või mõjuga meetmete erikomisjon</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Commissione speciale sulle decisioni anticipate in materia fiscale (tax ruling) e altre misure analoghe per natura o effetto</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Specialusis sprendimų dėl mokesčių ir kitų panašaus pobūdžio ar poveikio priemonių komitetas</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Īpašā komiteja nodokļu nolēmumu un rakstura vai ietekmes ziņā līdzīgu pasākumu jautājumos</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Comisia specială pentru deciziile fiscale și alte măsuri similare sau cu efecte similare</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Comissão Especial sobre as Decisões Fiscais Antecipadas e Outras Medidas de Natureza ou Efeitos Similares</skos:prefLabel>
      <dc:identifier>EP_TAXE</dc:identifier>
      <atold:op-code>EP_TAXE</atold:op-code>
