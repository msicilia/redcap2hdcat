      <skos:narrower rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/G24"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:definition xml:lang="en">Loose coalition of developing nations, designed to promote its members’ collective economic interests and create an enhanced joint negotiating capacity in the United Nations. There were 77 founding members of the organization, but the organization has since expanded to 133 member countries.</skos:definition>
   </skos:Concept>
