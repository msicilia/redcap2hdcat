   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_NONEURO11_1"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_NONEURO11_1</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000696</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="fi">Euroalueen ulkopuoliset jäsenvaltiot: Bulgaria, Tšekki, Tanska, Kroatia, Latvia, Liettua, Unkari, Puola, Romania, Ruotsi, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri mhux fiż-żona tal-euro: il-Bulgarija, ir-Repubblika Ċeka, id-Danimarka, il-Kroazja, il-Latvja, il-Litwanja, l-Ungerija, il-Polonja, ir-Rumanija, l-Isvezja, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwa członkowskie spoza strefy euro: Bułgaria, Republika Czeska, Dania, Chorwacja, Łotwa, Litwa, Węgry, Polska, Rumunia, Szwecja, Zjednoczone Królestwo</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ballstáit nach bhfuil sa limistéar euro: an Bhulgáir, Poblacht na Seice, an Danmhairg, an Chróit, an Laitvia, an Liotuáin, an Ungáir, an Pholainn, an Rómáin, an tSualainn, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy mimo eurozónu: Bulharsko, Česká republika, Dánsko, Chorvatsko, Lotyšsko, Litva, Maďarsko, Polsko, Rumunsko, Švédsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Non-euro area Member States: Bulgaria, Czech Republic, Denmark, Croatia, Latvia, Lithuania, Hungary, Poland, Romania, Sweden, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Euro zonai nepriklausančios valstybės narės: Bulgarija, Čekijos Respublika, Danija, Kroatija, Latvija, Lietuva, Vengrija, Lenkija, Rumunija, Švedija, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Estados miembros no pertenecientes a la zona del euro: Bulgaria, Chequia, Dinamarca, Croacia, Letonia, Lituania, Hungría, Polonia, Rumanía, Suecia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Stati membri non appartenenti all’area dell’euro: Bulgaria, Repubblica ceca, Danimarca, Croazia, Lettonia, Lituania, Ungheria, Polonia, Romania, Svezia, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki niso v euroobmočju: Bolgarija, Češka, Danska, Hrvaška, Latvija, Litva, Madžarska, Poljska, Romunija, Švedska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras nav eurozonas dalībnieces: Bulgārija, Čehijas Republika, Dānija, Horvātija, Latvija, Lietuva, Ungārija, Polija, Rumānija, Zviedrija, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Lidstaten buiten de eurozone: Bulgarije, Tsjechië, Denemarken, Kroatië, Letland, Litouwen, Hongarije, Polen, Roemenië, Zweden, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nicht dem Euro-Währungsgebiet angehörende Mitgliedstaaten: Bulgarien, Tschechische Republik, Dänemark, Kroatien, Lettland, Litauen, Ungarn, Polen, Rumänien, Schweden, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Medlemsstater utanför euroområdet: Bulgarien, Tjeckien, Danmark, Kroatien, Lettland, Litauen, Ungern, Polen, Rumänien, Sverige, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Euróövezeten kívüli tagállamok: Bulgária, Cseh Köztársaság, Dánia, Horvátország, Lettország, Litvánia, Magyarország, Lengyelország, Románia, Svédország, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави-членки извън еврозоната: България, Чешката република, Дания, Хърватия, Латвия, Литва, Унгария, Полша, Румъния, Швеция, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Estados-Membros não participantes na área do euro: Bulgária, República Checa, Dinamarca, Croácia, Letónia, Lituânia, Hungria, Polónia, Roménia, Suécia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Medlemsstater uden for Euroområdet: Bulgarien, Den Tjekkiske Republik, Danmark, Kroatien, Letland, Litauen, Ungarn, Polen, Rumænien, Sverige, Det Forenede Kongerige</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice izvan europodručja: Bugarska, Češka, Danska, Hrvastka, Latvija, Litva, Mađarska, Poljska, Rumunjska, Švedska, Ujedinjena Kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroalasse mittekuuluvad liikmesriigid: Bulgaaria, Tšehhi Vabariik, Taani, Horvaatia, Läti, Leedu, Ungari, Poola, Rumeenia, Rootsi, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">State membre din afara zonei euro: Bulgaria, Republica Cehă, Danemarca, Croația, Letonia, Lituania, Ungaria, Polonia, România, Suedia, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κράτη μέλη εκτός ζώνης ευρώ: Βουλγαρία, Τσεχική Δημοκρατία, Κροατία, Δανία, Λετονία, Λιθουανία, Ουγγαρία, Πολωνία, Ρουμανία, Σουηδία, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členské štáty, ktoré nepatria do eurozóny: Bulharsko, Česká republika, Dánsko, Chorvátsko, Lotyšsko, Litva, Maďarsko, Poľsko, Rumunsko, Švédsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres n’appartenant pas à la zone euro: Bulgarie, République tchèque, Danemark, Croatie, Lettonie, Lituanie, Hongrie, Pologne, Roumanie, Suède, Royaume-Uni</skos:prefLabel>
