   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_NONEURO10"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000351</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_NONEURO10</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="et">Euroalasse mittekuuluvad liikmesriigid: Bulgaaria, Tšehhi Vabariik, Taani, Läti, Leedu, Ungari, Poola, Rumeenia, Rootsi, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členský štát, ktorý nie je krajinou eurozóny: Bulharsko, Česká republika, Dánsko, Lotyšsko, Litva, Maďarsko, Poľsko, Rumunsko, Švédsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroalueen ulkopuoliset jäsenvaltiot: Bulgaria, Tšekki, Tanska, Latvia, Liettua, Unkari, Puola, Romania, Ruotsi, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">State membre din afara zonei euro: Bulgaria, Republica Cehă, Danemarca, Letonia, Lituania, Ungaria, Polonia, România, Suedia, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Euro zonai nepriklausančios valstybės narės: Bulgarija, Čekijos Respublika, Danija, Latvija, Lietuva, Vengrija, Lenkija, Rumunija, Švedija, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Medlemsstater uden for Euroområdet: Bulgarien, Den Tjekkiske Republik, Danmark, Letland, Litauen, Ungarn, Polen, Rumænien, Sverige, Det Forenede Kongerige</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Non-euro area Member States: Bulgaria, Czech Republic, Denmark, Latvia, Lithuania, Hungary, Poland, Romania, Sweden, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice izvan europodručja: Bugarska, Češka, Danska, Latvija, Litva, Mađarska, Poljska, Rumunjska, Švedska, Ujedinjena kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Estados miembros no pertenecientes a la zona del euro: Bulgaria, Chequia, Dinamarca, Letonia, Lituania, Hungría, Polonia, Rumanía, Suecia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Euróövezeten kívüli tagállamok: Bulgária, Cseh Köztársaság, Dánia, Lettország, Litvánia, Magyarország, Lengyelország, Románia, Svédország, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Stati membri non appartenenti all’area dell’euro: Bulgaria, Repubblica Ceca, Danimarca, Lettonia, Lituania, Ungheria, Polonia, Romania, Svezia, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras nav ieviesušas euro: Bulgārija, Čehijas Republika, Dānija, Latvija, Lietuva, Ungārija, Polija, Rumānija, Zviedrija, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κράτη μέλη εκτός ζώνης ευρώ: Βουλγαρία, Τσεχική Δημοκρατία, Δανία, Λετονία, Λιθουανία, Ουγγαρία, Πολωνία, Ρουμανία, Σουηδία, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri mhux fiż-żona tal-euro: il-Bulgarija, ir-Repubblika Ċeka, id-Danimarka, il-Latvja, il-Litwanja, l-Ungerija, il-Polonja, ir-Rumanija, l-Isvezja, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Estados-Membros não participante na área do euro: Bulgária, República Checa, Dinamarca, Letónia, Lituânia, Hungria, Polónia, Roménia, Suécia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki niso v euroobmočju: Bolgarija, Češka, Danska, Latvija, Litva, Madžarska, Poljska, Romunija, Švedska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Lidstaten buiten de eurozone: Bulgarije, Tsjechische Republiek, Denemarken, Letland, Litouwen, Hongarije, Polen, Roemenië, Zweden, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави-членки извън еврозоната: България, Чешката република, Дания, Латвия, Литва, Унгария, Полша, Румъния, Швеция, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwo członkowskie spoza strefy euro: Bułgaria, Republika Czeska, Dania, Łotwa, Litwa, Węgry, Polska, Rumunia, Szwecja, Zjednoczone Królestwo</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Medlemsstater utanför euroområdet: Bulgarien, Tjeckien, Danmark, Lettland, Litauen, Ungern, Polen, Rumänien, Sverige, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres n’appartenant pas à la zone euro: Bulgarie, République tchèque, Danemark, Lettonie, Lituanie, Hongrie, Pologne, Roumanie, Suède, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nicht dem Euro-Währungsgebiet angehörende Mitgliedstaaten: Bulgarien, Tschechische Republik, Dänemark, Lettland, Litauen, Ungarn, Polen, Rumänien, Schweden, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy mimo eurozónu: Bulharsko, Česká republika, Dánsko, Lotyšsko, Litva, Maďarsko, Polsko, Rumunsko, Švédsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ballstáit nach bhfuil sa limistéar euro: an Bhulgáir, Poblacht na Seice, an Danmhairg, an Laitvia, an Liotuáin, an Ungáir, an Pholainn, an Rómáin, an tSualainn, an Ríocht Aontaithe</skos:prefLabel>
      <dc:identifier>EUMS_NONEURO10</dc:identifier>
