      <skos:altLabel xml:lang="en">AHWP DF</skos:altLabel>
      <skos:altLabel xml:lang="de">AHWP DF</skos:altLabel>
      <skos:altLabel xml:lang="pl">AHWP DF</skos:altLabel>
