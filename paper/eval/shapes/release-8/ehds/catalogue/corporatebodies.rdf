      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001128</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">COR_CONST</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/COR"/>
      <skos:prefLabel xml:lang="ro">Comisia pentru guvernanţă europeană şi spaţiul de libertate şi justiţie</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Europos valdymo ir laisvės ir teisingumo erdvės komisija</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Commissie Europese governance en ruimte van vrijheid, veiligheid en recht</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Underudvalget for Styreformer i EU og Området med Frihed, Sikkerhed og Retfærdighed</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kummissjoni għall-Affarijiet Kostituzzjonali, il-Gvernanza Ewropea u l-Qasam tal-Libertà, Sigurtà u Ġustizzja</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">„Európai kormányzás, a szabadság és jogérvényesítés térsége” szakbizottság</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Commissione Affari costituzionali, governance europea, spazio di libertà, sicurezza e giustizia</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Fachkommission für Regieren in Europa und für den Raum der Freiheit, der Sicherheit und des Rechts</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Commission for European Governance and the Area of Freedom, Security and Justice</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Eiropas pārvaldības un brīvības, drošības un tiesiskuma telpas komisija</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Komisija za ustavne zadeve, evropsko upravo ter območje svobode, varnosti in pravice</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Επιτροπή «Ευρωπαϊκή διακυβέρνηση και χώρος ελευθερίας και δικαιοσύνης»</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Comissão da Governação Europeia e do Espaço de Liberdade e de Justiça</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Commission de la gouvernance européenne et de l’espace de liberté, de sécurité et de justice</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Komisia pre európske riadenie a priestor slobody, bezpečnosti a spravodlivosti</skos:prefLabel>
