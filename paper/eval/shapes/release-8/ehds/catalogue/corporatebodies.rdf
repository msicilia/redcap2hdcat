   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/REPRES_PERM"
                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">REPRES_PERM</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001391</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="es">Representaciones Permanentes</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Representações permanentes</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Ständiga representationer</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De Faste Repræsentationer</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Stálá zastoupení</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Állandó képviseletek</skos:prefLabel>
