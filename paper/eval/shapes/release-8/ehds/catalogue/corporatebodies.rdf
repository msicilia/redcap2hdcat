      <skos:altLabel xml:lang="fr">CPLRE</skos:altLabel>
      <skos:altLabel xml:lang="fr">Congrès</skos:altLabel>
      <skos:altLabel xml:lang="sk">KMROE</skos:altLabel>
      <skos:altLabel xml:lang="en">Congress</skos:altLabel>
      <skos:altLabel xml:lang="lv">EVRvK</skos:altLabel>
      <skos:exactMatch rdf:resource="http://eurovoc.europa.eu/7346"/>
      <skos:definition xml:lang="fr">Le Congrès des pouvoirs locaux et régionaux du Conseil de l’Europe est une assemblée politique paneuropéenne composée de conseillers régionaux et municipaux, maires et présidents de région élus, représentant plus de 200000 collectivités de 47 pays européens. Il a pour mission de promouvoir la démocratie territoriale, d’améliorer la gouvernance locale et régionale et de renforcer l’autonomie des collectivités.</skos:definition>
      <skos:definition xml:lang="en">The Congress of Local and Regional Authorities pursues its work as the institution of the Council of Europe responsible for strengthening local and regional democracy in its 47 member states. Composed of two chambers – the Chamber of Local Authorities and the Chamber of Regions – and three committees, it comprises elected representatives representing more than 200,000 local and regional authorities.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/COU_EUR_EYF"
                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001318</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">COU_EUR_EYF</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/COU_EUR"/>
      <skos:prefLabel xml:lang="nl">Europees Jeugdfonds</skos:prefLabel>
      <skos:prefLabel xml:lang="en">European Youth Foundation</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Fundação Europeia da Juventude</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroopan nuorisosäätiö</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Eiropas Jaunatnes fonds</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Европейски младежки фонд</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroopa Noorsoofond</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Europska zaklada za mladež</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Den Europæiske Ungdomsfond</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Fonds européen pour la jeunesse</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Fondo Europeo de la Juventud</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Europarådets ungdomsfond</skos:prefLabel>
      <skos:prefLabel xml:lang="sr">Европски фонд за омладину</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Europos jaunimo fondas</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Európsky fond pre mládež</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Europejski Fundusz Młodzieży</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Europäischer Jugendfonds</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Ευρωπαϊκό Ταμείο για τη Νεολαία</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Fundația Europeană pentru Tineret</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Evropski sklad za mlade</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Fondúireacht Óige na hEorpa</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Fondo europeo per la gioventù</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Evropský fond pro mládež</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Fondazzjoni Ewropea taż-Żgħażagħ</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Európai Ifjúsági Alap</skos:prefLabel>
      <dc:identifier>COU_EUR_EYF</dc:identifier>
      <atold:op-code>COU_EUR_EYF</atold:op-code>
      <at:op-code>COU_EUR_EYF</at:op-code>
      <at:start.use>1972-01-01</at:start.use>
      <at:authority-code>COU_EUR_EYF</at:authority-code>
      <skos:altLabel xml:lang="en">EYF</skos:altLabel>
      <skos:altLabel xml:lang="fr">FEJ</skos:altLabel>
      <skos:definition xml:lang="en">The European Youth Foundation is a fund established by the Council of Europe to provide financial support for European youth activities.Its purpose is to encourage co-operation among young people in Europe by providing financial support to such European youth activities which serve the promotion of peace, understanding and co-operation in a spirit of respect for the Council of Europe’s fundamental values such as human rights, democracy, tolerance and solidarity.</skos:definition>
      <skos:definition xml:lang="fr">Le Fonds Européen pour la Jeunesse est un établissement du Conseil de l’Europe qui apporte un soutien financier aux activités européennes de jeunesse. Son but est d’encourager la compréhension et la coopération parmi les jeunes en donnant des soutiens financiers aux activités dans le domaine de travail de la jeunesse et dans le respect des valeurs fondamentales promues par le Conseil de l’Europe, en particulier les droits de l’homme, la démocratie, la tolérance et la solidarité.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/COU_EUR_DB"
