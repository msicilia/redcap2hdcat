   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/DG01"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#PUB_CORP">DG01</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000155</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">DG01</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/COM"/>
      <skos:prefLabel xml:lang="lt">GD I – Išorės santykiai. Prekybos politika ir santykiai su Šiaurės Amerika, Tolimaisiais Rytais, Australija ir Naujaja Zelandija</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">DG I – Relations extérieures: politique commerciale, relations avec l’Amérique du Nord, l’Extrême Orient, l’Australie et la Nouvelle–Zélande</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">GŘ I – Vnější vztahy: obchodní politika a vztahy se Severní Amerikou, Dálným východem, Austrálií a Novým Zélandem</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">PO I – ulkosuhteet: kauppapolitiikka ja -suhteet Pohjois-Amerikkaan, Kaukoitään, Australiaan ja Uuteen-Seelantiin</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">DG I – Stosunki zewnętrzne: polityka handlowa i stosunki z Ameryką Północną, Dalekim Wschodem, Australią i Nową Zelandią</skos:prefLabel>
      <skos:prefLabel xml:lang="el">ΓΔ I – Εξωτερικών Σχέσεων: Εμπορική Πολιτική και Σχέσεις με τη Βόρεια Αμερική, την Άπω Ανατολή, την Αυστραλία και τη Νέα Ζηλανδία</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">ГД І – Външни отношения: търговска политика и отношения със Северна Америка, Далечния изток, Австралия и Нова Зеландия</skos:prefLabel>
      <skos:prefLabel xml:lang="da">GD I – Eksterne Forbindelser: Handelspolitik, Forbindelser med Nordamerika, Fjernøsten, Australien og New Zealand</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">AS I – Caidreamh Seachtrach: Beartas Tráchtála agus Caidrimh le Tuaisceart Meiriceá, an Cianoirthear, an Astráil agus an Nua-Shéalainn</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">DĠ I – Relazzjonijiet Esterni: Il-Politika Kummerċjali u r-Relazzjonijiet mal-Amerika ta’ Fuq, il-Lvant Imbiegħed, l-Awstralja u n-New Zealand</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">GD I – Yttre förbindelser: Handelspolitik och förbindelser med Nordamerika, Fjärran Östern, Australien och Nya Zeeland</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">DG I – Relações Externas: Política Comercial, Relações com a América do Norte, o Extremo Oriente, a Austrália e a Nova Zelândia</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">DG I – Ārējās attiecības: komerciālā politika un attiecības ar Ziemeļameriku, Tālajiem Austrumiem, Austrāliju un Jaunzēlandi</skos:prefLabel>
      <skos:prefLabel xml:lang="de">GD I – Außenbeziehungen: Handelspolitik, Beziehungen zu Nordamerika, zum Fernen Osten sowie zu Australien und Neuseeland</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">GU I. – Vanjski odnosi: trgovinska politika i odnosi sa Sjevernom Amerikom, Dalekim istokom, Australijom i Novim Zelandom</skos:prefLabel>
      <skos:prefLabel xml:lang="et">I peadirektoraat – välissuhted: kaubanduspoliitika ning suhted Põhja-Ameerika, Kaug-Ida, Austraalia ja Uus-Meremaaga</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">GD I – zunanji odnosi: trgovinska politika ter odnosi s Severno Ameriko, Daljnim vzhodom, Avstralijo in Novo Zelandijo</skos:prefLabel>
      <skos:prefLabel xml:lang="es">DG I – Relaciones Exteriores: Política Comercial, Relaciones con América del Norte, Extremo Oriente, Australia y Nueva Zelanda</skos:prefLabel>
      <skos:prefLabel xml:lang="it">DG I – Relazioni esterne: politica commerciale, relazioni con l’America settentrionale, l’Estremo Oriente, l’Australia e la Nuova Zelanda</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">GR I – vonkajšie vzťahy: obchodná politika a vzťahy so Severnou Amerikou, Ďalekým východom, Austráliou a Novým Zélandom</skos:prefLabel>
      <skos:prefLabel xml:lang="en">DG I – External Relations: Commercial Policy and Relations with North America, the Far East, Australia and New Zealand</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">DG I – Relații Externe: Politica Comercială și Relațiile cu America de Nord, Orientul Îndepărtat, Australia și Noua Zeelandă</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">I. Főigazgatóság – Külkapcsolatok: Kereskedelmi Politika és Kapcsolatok Észak-Amerikával, a Távol-Kelettel, Ausztráliával és Új-Zélanddal</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">DG I – Buitenlandse Betrekkingen: Handelsbeleid, Betrekkingen met Noord-Amerika, het Verre Oosten, Australië en Nieuw-Zeeland</skos:prefLabel>
      <dc:identifier>DG01</dc:identifier>
      <atold:op-code>DG01</atold:op-code>
      <at:op-code>DG01</at:op-code>
      <at:start.use>1993-01-01</at:start.use>
