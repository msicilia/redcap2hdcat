      <skos:prefLabel xml:lang="sv">Myndigheten för bekämpning av penningtvätt och finansiering av terrorism</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Орган за борба с изпирането на пари и финансирането на тероризма</skos:prefLabel>
