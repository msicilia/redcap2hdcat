      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">CENELCOM</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001294</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:prefLabel xml:lang="fr">Comité européen de coordination des normes électriques dans le marché commun</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroopa ühisturu elektrotehniliste standardite koordineerimise kommitee</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroopan sähkötekniikan standardointikomitea yhteismarkkinoita varten</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kumitat Ewropew għall-Koordinazzjoni tal-Istandardizzazzjoni tal-Elettroteknika fis-Suq Komuni</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Comité Europeu de Coordenação das Normas Elétricas no Mercado Comum</skos:prefLabel>
      <skos:prefLabel xml:lang="en">European Committee for the Coordination of Electrotechnical Standards in the Common Market</skos:prefLabel>
      <dc:identifier>CENELCOM</dc:identifier>
      <atold:op-code>CENELCOM</atold:op-code>
      <at:op-code>CENELCOM</at:op-code>
      <at:start.use>1959-01-01</at:start.use>
      <at:authority-code>CENELCOM</at:authority-code>
      <at:end.use>1972-12-31</at:end.use>
      <skos:altLabel xml:lang="en">CENELCOM</skos:altLabel>
      <skos:altLabel xml:lang="fr">CENELCOM</skos:altLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:definition xml:lang="en">The European Committee for the Coordination of Electrotechnical Standards in the Common Market (CENELCOM) aimed at providing harmonized standards in order to eliminate trade barriers. In 1973 CENEL and CENELCOM joined up to form the European Committee for Electrotechnical Standardisation (CENELEC), which counted Austria among its members.</skos:definition>
   </skos:Concept>
