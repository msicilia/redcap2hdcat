      <skos:prefLabel xml:lang="pt">Eurosistema</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Eurosysteem</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Eurosystem</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Eurosystem</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Eurosystem</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Eurórendszer</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Eurosustav</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Eurosystém</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Eurosystém</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Eurosistem</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Eurosistem</skos:prefLabel>
      <dc:identifier>EUROSYSTEM</dc:identifier>
      <atold:op-code>EUROSYSTEM</atold:op-code>
      <at:op-code>EUROSYSTEM</at:op-code>
      <at:start.use>1999-01-01</at:start.use>
      <at:authority-code>EUROSYSTEM</at:authority-code>
      <skos:exactMatch rdf:resource="http://eurovoc.europa.eu/c_d1f03d01"/>
      <skos:definition xml:lang="fr">La Banque centrale européenne et les banques centrales nationales constituent le Système européen de banques centrales (SEBC). La Banque centrale européenne et les banques centrales nationales des États membres dont la monnaie est l’euro, qui constituent l’Eurosystème, conduisent la politique monétaire de l’Union.</skos:definition>
      <skos:definition xml:lang="en">The European Central Bank, together with the national central banks, shall constitute the European System of Central Banks (ESCB). The European Central Bank, together with the national central banks of the Member States whose currency is the euro, which constitute the Eurosystem, shall conduct the monetary policy of the Union.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_NONEURO8"
                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_NONEURO8</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FD_050">EM-NON-EURO</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001619</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="nl">Lidstaten buiten de eurozone: Bulgarije, Tsjechië, Denemarken, Kroatië, Hongarije, Polen, Roemenië, Zweden</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ballstáit nach bhfuil sa limistéar euro: an Bhulgáir, an tSeicia, an Danmhairg, an Chróit, an Ungáir, an Pholainn, an Rómáin, an tSualainn</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Estados-Membros não participante na área do euro: Bulgária, Chéquia, Dinamarca, Croácia, Hungria, Polónia, Roménia, Suécia</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">State membre din afara zonei euro: Bulgaria, Cehia, Danemarca, Croația, Ungaria, Polonia, România, Suedia</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwo członkowskie spoza strefy euro: Bułgaria, Czechy, Dania, Chorwacja, Węgry, Polska, Rumunia, Szwecja</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členský štát, ktorý nie je krajinou eurozóny: Bulharsko, Česko, Dánsko, Chorvátsko, Maďarsko, Poľsko, Rumunsko, Švédsko</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κράτη μέλη εκτός ζώνης ευρώ: Βουλγαρία, Τσεχία, Δανία, Κροατία, Ουγγαρία, Πολωνία, Ρουμανία, Σουηδία</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Stati membri non appartenenti all’area dell’euro: Bulgaria, Cechia, Danimarca, Croazia, Ungheria, Polonia, Romania, Svezia</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroalueen ulkopuoliset jäsenvaltiot: Bulgaria, Tšekki, Tanska, Kroatia, Unkari, Puola, Romania, Ruotsi</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Euróövezeten kívüli tagállamok: Bulgária, Csehország, Dánia, Horvátország, Magyarország, Lengyelország, Románia, Svédország</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Euro zonai nepriklausančios valstybės narės: Bulgarija, Čekija, Danija, Kroatija, Vengrija, Lenkija, Rumunija, Švedija</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroalasse mittekuuluvad liikmesriigid: Bulgaaria, Tšehhi, Taani, Horvaatia, Ungari, Poola, Rumeenia, Rootsi</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Medlemsstater uden for Euroområdet: Bulgarien, Tjekkiet, Danmark, Kroatien, Ungarn, Polen, Rumænien, Sverige</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri mhux fiż-żona tal-euro: il-Bulgarija, iċ-Ċekja, id-Danimarka, il-Kroazja, l-Ungerija, il-Polonja, ir-Rumanija, l-Isvezja</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nicht dem Euro-Währungsgebiet angehörende Mitgliedstaaten: Bulgarien, Tschechien, Dänemark, Kroatien, Ungarn, Polen, Rumänien, Schweden</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Non-euro area Member States: Bulgaria, Czechia, Denmark, Croatia, Hungary, Poland, Romania, Sweden</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki niso v euroobmočju: Bolgarija, Češka, Danska, Hrvaška, Madžarska, Poljska, Romunija, Švedska</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Medlemsstater utanför euroområdet: Bulgarien, Tjeckien, Danmark, Kroatien, Ungern, Polen, Rumänien, Sverige</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави членки извън еврозоната: България, Чехия, Дания, Хърватия, Унгария, Полша, Румъния, Швеция</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres n’appartenant pas à la zone euro: Bulgarie, Tchéquie, Danemark, Croatie, Hongrie, Pologne, Roumanie, Suède</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Estados miembros no pertenecientes a la zona del euro: Bulgaria, Chequia, Dinamarca, Croacia, Hungría, Polonia, Rumanía, Suecia</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice izvan europodručja: Bugarska, Češka, Danska, Hrvastka, Mađarska, Poljska, Rumunjska, Švedska</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras neietilpst eurozonā: Bulgārija, Čehija, Dānija, Horvātija, Ungārija, Polija, Rumānija, Zviedrija</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy mimo eurozónu: Bulharsko, Česko, Dánsko, Chorvatsko, Maďarsko, Polsko, Rumunsko, Švédsko</skos:prefLabel>
