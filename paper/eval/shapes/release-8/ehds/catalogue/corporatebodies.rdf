      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="nl">De zes lidstaten: België, Duitsland, Frankrijk, Italië, Luxemburg, Nederland</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Die sechs Mitgliedstaaten: Belgien, Deutschland, Frankreich, Italien, Luxemburg, Niederlande</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Шестте държави-членки: Белгия, Германия, Фрация, Италия, Люксембург, Нидерландия</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Os seis Estados-Membros: Bélgica, Alemanha, França, Itália, Luxemburgo, Países Baixos</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τα έξι κράτη μέλη: Βέλγιο, Γερμανία, Γαλλία, Ιταλία, Λουξεμβούργο, Κάτω Χώρες</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Šešios valstybės narės: Belgija, Vokietija, Prancūzija, Italija, Liuksemburgas, Nyderlandai</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Šesť členských štátov: Belgicko, Nemecko, Francúzsko, Taliansko, Luxembursko, Holandsko</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Na Sé Bhallstát: an Bheilg, an Ghearmáin, an Fhrainc, an Iodáil, Lucsamburg, an Ísiltír</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Is-sitt Stati Membri: il-Belġju, il-Ġermanja, Franza, l-Italja, il-Lussemburgu, il-Pajjiżi l-Baxxi</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Sešas dalībvalstis: Beļģija, Vācija, Francija, Itālija, Luksemburga, Nīderlande</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Les six États membres: Belgique, Allemagne, France, Italie, Luxembourg, Pays-Bas</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Kuusi jäsenvaltiota: Belgia, Saksa, Ranska, Italia, Luxemburg, Alankomaat</skos:prefLabel>
      <skos:prefLabel xml:lang="it">I sei Stati membri: Belgio, Germania, Francia, Italia, Lussemburgo, Paesi Bassi</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Šest država članica: Belgija, Njemačka, Francuska, Italija, Luksemburg, Nizozemska</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Cele șase state membre: Belgia, Germania, Franţa, Italia, Luxemburg, Ţările de Jos</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Los seis Estados miembros: Bélgica, Alemania, Francia, Italia, Luxemburgo, Países Bajos</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">A hat tagállam: Belgium, Németország, Franciaország, Olaszország, Luxemburg, Hollandia</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Sześć państw członkowskich: Belgia, Niemcy, Francja, Włochy, Luksemburg, Niderlandy</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">De sex medlemsstaterna: Belgien, Tyskland, Frankrike, Italien, Luxemburg, Nederländerna</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Šest členských států: Belgie, Německo, Francie, Itálie, Lucembursko, Nizozemsko</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Kuus liikmesriiki: Belgia, Saksamaa, Prantsusmaa, Itaalia, Luksemburg, Madalmaad</skos:prefLabel>
      <skos:prefLabel xml:lang="en">The six Member States: Belgium, Germany, France, Italy, Luxembourg, Netherlands</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Šest držav članic: Belgija, Nemčija, Francija, Italija, Luksemburg, Nizozemska</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De seks medlemsstater: Belgien, Tyskland, Frankrig, Italien, Luxembourg, Nederlandene</skos:prefLabel>
