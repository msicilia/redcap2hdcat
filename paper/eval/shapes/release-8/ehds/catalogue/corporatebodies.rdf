      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EESC"/>
      <skos:prefLabel xml:lang="fr">Section spécialisée «Agriculture, développement rural, environnement»</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Strokovna skupina za kmetijstvo, razvoj podeželja in okolje</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Lauksaimniecības, lauku attīstības un vides specializētā nodaļa</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Secțiunea pentru agricultură, dezvoltare rurală și protecția mediului</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Odborná sekcia pre poľnohospodárstvo, rozvoj vidieka a životné prostredie</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Специализирана секция „Земеделие, развитие на селските райони, околна среда”</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Secção Especializada de Agricultura, Desenvolvimento Rural e Ambiente</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Ειδικευμένο τμήμα “Γεωργία, αγροτική ανάπτυξη, περιβάλλον”</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">„Mezőgazdaság, vidékfejlesztés és környezetvédelem” szekció</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Žemės ūkio, kaimo plėtros ir aplinkos skyrius</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Sezione specializzata Agricoltura, sviluppo rurale, ambiente</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Fachgruppe Landwirtschaft, ländliche Entwicklung, Umweltschutz</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Afdeling Landbouw, plattelandsontwikkeling, milieu</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">“Maatalous, maaseudun kehittäminen, ympäristö” -erityisjaosto</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Põllumajanduse, maaelu arengu ja keskkonna sektsioon</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Section for Agriculture, Rural Development and the Environment</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Facksektionen för jordbruk, landsbygdsutveckling och miljö</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Sección Especializada de Agricultura, Desarrollo Rural y Medio Ambiente</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Den Faglige Sektion for Landbrug, Udvikling af Landdistrikterne og Miljø</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">An Rannóg Talmhaíochta, Forbartha Tuaithe agus Comhshaoil</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Sekcja Rolnictwa, Rozwoju Wsi i Środowiska Naturalnego</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Specializovaná sekce Zemědělství, rozvoj venkova, životní prostředí</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Sezzjoni speċjalizzata għall-Agrikoltura, l-Iżvilupp Rurali u l-Ambjent</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Stručna skupina za poljoprivredu, ruralni razvoj i zaštitu okoliša</skos:prefLabel>
