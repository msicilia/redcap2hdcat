      <skos:altLabel xml:lang="en">Economic Commission for Latin America</skos:altLabel>
      <skos:definition xml:lang="en">The Economic Commission for Latin America was established by Economic and Social Council resolution 106(VI). The scope of the Commission’s work was later broadened to include the countries of the Caribbean, and by resolution 1984/67 of 27 July 1984, the Economic Council decided to change its name to the Economic Commission for Latin America and the Caribbean.</skos:definition>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/UNECWA"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001199</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">UNECWA</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/UNO"/>
      <skos:prefLabel xml:lang="lv">Apvienoto Nāciju Organizācijas Ekonomikas komisija Rietumāzijai</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">YK:n Länsi-Aasian talouskomissio</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kummissjoni Ekonomika tan-Nazzjonijiet Uniti għall-Ażja tal-Punent</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Ühinenud Rahvaste Organisatsiooni Lääne-Aasia majanduskomisjon</skos:prefLabel>
      <skos:prefLabel xml:lang="en">United Nations Economic Commission for Western Asia</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Commission économique des Nations unies pour l’Asie occidentale</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Comisión Económica para Asia Occidental de las Naciones Unidas</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Икономическа комисия на ООН за Западна Азия</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Comissão Económica das Nações Unidas para a Ásia Ocidental</skos:prefLabel>
      <dc:identifier>UNECWA</dc:identifier>
      <atold:op-code>UNECWA</atold:op-code>
      <at:op-code>UNECWA</at:op-code>
      <at:start.use>1973-08-09</at:start.use>
      <at:authority-code>UNECWA</at:authority-code>
      <at:end.use>1985-06-30</at:end.use>
      <skos:altLabel xml:lang="en">Economic Commission for Western Asia</skos:altLabel>
      <skos:definition xml:lang="en">The Economic Commission for Western Asia (ECWA) was established pursuant to the Economic and Social Council’s resolution 1818 (LV). The purpose of setting up the Commission was to raise the level of economic activity in member countries and strengthen cooperation among them. It was also intended to meet the need of the countries in Western Asia for the services of a regional economic commission to promote the development efforts in the region. In recognition of the social component of its work, the Commission was entrusted with new responsibilities in the social field by virtue of Economic and Social Council resolution 69/1985 of July 1985. Its name therefore became the Economic and Social Commission for Western Asia.</skos:definition>
   </skos:Concept>
