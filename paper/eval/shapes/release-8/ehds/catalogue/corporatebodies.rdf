   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_NONEURO10_1"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000751</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_NONEURO10_1</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="mt">L-Istati Membri mhux fiż-żona tal-euro: il-Bulgarija, ir-Repubblika Ċeka, id-Danimarka, il-Kroazja, il-Litwanja, l-Ungerija, il-Polonja, ir-Rumanija, l-Isvezja, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави членки извън еврозоната: България, Чешката република, Дания, Хърватия, Литва, Унгария, Полша, Румъния, Швеция, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy mimo eurozónu: Bulharsko, Česká republika, Dánsko, Chorvatsko, Litva, Maďarsko, Polsko, Rumunsko, Švédsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras nav ieviesušas euro: Bulgārija, Čehijas Republika, Dānija, Horvātija, Lietuva, Ungārija, Polija, Rumānija, Zviedrija, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroalueen ulkopuoliset jäsenvaltiot: Bulgaria, Tšekki, Tanska, Kroatia, Liettua, Unkari, Puola, Romania, Ruotsi, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nicht dem Euro-Währungsgebiet angehörende Mitgliedstaaten: Bulgarien, Tschechische Republik, Dänemark, Kroatien, Litauen, Ungarn, Polen, Rumänien, Schweden, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Euro zonai nepriklausančios valstybės narės: Bulgarija, Čekijos Respublika, Danija, Kroatija, Lietuva, Vengrija, Lenkija, Rumunija, Švedija, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Estados-Membros não participante na área do euro: Bulgária, República Checa, Dinamarca, Croácia, Lituânia, Hungria, Polónia, Roménia, Suécia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice izvan europodručja: Bugarska, Češka, Danska, Hrvastka, Litva, Mađarska, Poljska, Rumunjska, Švedska, Ujedinjena kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Euróövezeten kívüli tagállamok: Bulgária, Cseh Köztársaság, Dánia, Horvátország, Litvánia, Magyarország, Lengyelország, Románia, Svédország, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Ballstáit nach bhfuil sa limistéar euro: an Bhulgáir, Poblacht na Seice, an Danmhairg, an Chróit, an Liotuáin, an Ungáir, an Pholainn, an Rómáin, an tSualainn, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">State membre din afara zonei euro: Bulgaria, Republica Cehă, Danemarca, Croația, Lituania, Ungaria, Polonia, România, Suedia, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κράτη μέλη εκτός ζώνης ευρώ: Βουλγαρία, Τσεχική Δημοκρατία, Κροατία, Δανία, Λιθουανία, Ουγγαρία, Πολωνία, Ρουμανία, Σουηδία, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Medlemsstater uden for Euroområdet: Bulgarien, Den Tjekkiske Republik, Danmark, Kroatien, Litauen, Ungarn, Polen, Rumænien, Sverige, Det Forenede Kongerige</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Stati membri non appartenenti all’area dell’euro: Bulgaria, Repubblica ceca, Danimarca, Croazia, Lituania, Ungheria, Polonia, Romania, Svezia, Regno Unito</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Lidstaten buiten de eurozone: Bulgarije, Tsjechië, Denemarken, Kroatië, Litouwen, Hongarije, Polen, Roemenië, Zweden, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroalasse mittekuuluvad liikmesriigid: Bulgaaria, Tšehhi Vabariik, Taani, Horvaatia, Ungari, Poola, Rumeenia, Rootsi, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki niso v euroobmočju: Bolgarija, Češka, Danska, Hrvaška, Litva, Madžarska, Poljska, Romunija, Švedska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Non-euro area Member States: Bulgaria, Czech Republic, Denmark, Croatia, Lithuania, Hungary, Poland, Romania, Sweden, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Estados miembros no pertenecientes a la zona del euro: Bulgaria, Chequia, Dinamarca, Croacia, Lituania, Hungría, Polonia, Rumanía, Suecia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členské štáty, ktoré nie sú krajinami eurozóny: Bulharsko, Česká republika, Dánsko, Chorvátsko, Litva, Maďarsko, Poľsko, Rumunsko, Švédsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres n’appartenant pas à la zone euro: Bulgarie, République tchèque, Danemark, Croatie, Lituanie, Hongrie, Pologne, Roumanie, Suède, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwa członkowskie spoza strefy euro: Bułgaria, Republika Czeska, Dania, Chorwacja, Litwa, Węgry, Polska, Rumunia, Szwecja, Zjednoczone Królestwo</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Medlemsstater utanför euroområdet: Bulgarien, Tjeckien, Danmark, Kroatien, Litauen, Ungern, Polen, Rumänien, Sverige, Förenade kungariket</skos:prefLabel>
      <dc:identifier>EUMS_NONEURO10_1</dc:identifier>
      <atold:op-code>EUMS_NONEURO10_1</atold:op-code>
