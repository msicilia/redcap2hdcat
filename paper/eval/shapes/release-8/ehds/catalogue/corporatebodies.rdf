   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/COR_COM6"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001162</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">COR_COM6</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/COR"/>
      <skos:prefLabel xml:lang="pt">Comissão 6 Emprego, política económica, mercado único, indústria, PME</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Comisión 6. Empleo, Política Económica, Mercado Único, Industria y PYME</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">6. komisija. Nodarbinātība, ekonomikas politika, vienotais tirgus, rūpniecība, MVU</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Valiokunta 6 – Työllisyys, talouspolitiikka, yhteismarkkinat, teollisuus, pk-yritykset</skos:prefLabel>
      <skos:prefLabel xml:lang="et">6. komisjon: tööhõive, majanduspoliitika, ühisturg, tööstus, VKEd</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Komisija Nr. 6. Darbas, ekonominė politika, bendroji rinka, pramonė, mažosios ir vidutinės įmonės</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kummissjoni 6 Impjieg, politika ekonomika, suq uniku, indusrija, SMEs</skos:prefLabel>
