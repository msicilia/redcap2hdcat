      <skos:altLabel xml:lang="nl">IFAD</skos:altLabel>
      <skos:altLabel xml:lang="hr">IFAD</skos:altLabel>
      <skos:altLabel xml:lang="mt">IFAD</skos:altLabel>
      <skos:altLabel xml:lang="ga">IFAD</skos:altLabel>
      <skos:altLabel xml:lang="fi">IFAD</skos:altLabel>
