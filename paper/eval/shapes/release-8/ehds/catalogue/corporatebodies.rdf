      <skos:altLabel xml:lang="es">SVE</skos:altLabel>
      <skos:altLabel xml:lang="pt">SVE</skos:altLabel>
      <skos:altLabel xml:lang="fr">SVE</skos:altLabel>
      <skos:altLabel xml:lang="it">SVE</skos:altLabel>
