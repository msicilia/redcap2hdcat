      <skos:prefLabel xml:lang="en">United Nations Advisory Committee on Science and Technology for Development</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Apvienoto Nāciju Organizācijas Zinātnes un tehnoloģiju attīstības padomdevēja komiteja</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Comite Consultivo de las Naciones Unidas de Ciencia y Tecnologia para el Desarrollo</skos:prefLabel>
      <skos:prefLabel xml:lang="et">ÜRO teaduse ja tehnoloogia arendamise nõuandekomitee</skos:prefLabel>
