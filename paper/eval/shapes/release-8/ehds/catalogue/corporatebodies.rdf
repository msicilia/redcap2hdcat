      <skos:altLabel xml:lang="el">ΔΟΧ</skos:altLabel>
      <skos:altLabel xml:lang="ga">IFC</skos:altLabel>
      <skos:altLabel xml:lang="hr">IFC</skos:altLabel>
      <skos:altLabel xml:lang="lv">IFC</skos:altLabel>
      <skos:altLabel xml:lang="de">IFC</skos:altLabel>
