   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/CHR"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">CHR</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001230</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/UNO"/>
      <skos:prefLabel xml:lang="lv">Cilvēktiesību centrs</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Centro para os Direitos do Homem</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Inimõiguste Keskus</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Център за човешките права</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Centre pour les droits de l’homme</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Centre for Human Rights</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Ċentru għad-Drittijiet tal-Bniedem</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Centro de Derechos Humanos</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Ihmisoikeuskeskus</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Žmogaus teisių centras</skos:prefLabel>
      <dc:identifier>CHR</dc:identifier>
      <atold:op-code>CHR</atold:op-code>
      <at:op-code>CHR</at:op-code>
      <at:start.use>1980-01-01</at:start.use>
      <at:authority-code>CHR</at:authority-code>
      <at:end.use>1997-09-14</at:end.use>
      <skos:altLabel xml:lang="fr">HR</skos:altLabel>
      <skos:altLabel xml:lang="es">CDH</skos:altLabel>
      <skos:altLabel xml:lang="en">United Nations Centre for Human Rights</skos:altLabel>
      <skos:altLabel xml:lang="en">CHR</skos:altLabel>
      <skos:definition xml:lang="en">Organizationally, it started as a small division at United Nations Headquarters in the 1940s. The division later moved to Geneva and was upgraded to the Centre for Human Rights in the 1980s. At the World Conference on Human Rights in 1993, the international community decided to establish a more robust human rights mandate with stronger institutional support. Accordingly, Member States of the United Nations created OHCHR by a General Assembly Resolution in 1993.</skos:definition>
   </skos:Concept>
