      <skos:altLabel xml:lang="sl">EADI</skos:altLabel>
      <skos:altLabel xml:lang="it">EADI</skos:altLabel>
      <skos:exactMatch rdf:resource="http://eurovoc.europa.eu/168"/>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:definition xml:lang="fr">L’association Européenne des Instituts de Recherche et de Formation en Matière de Développement est un réseau européen couvrant les domaines de la recherche en matière de Développement.</skos:definition>
      <skos:definition xml:lang="en">EADI is a Europe-wide network of institutes, researchers and students of various disciplines in the field of development studies. The association is an independent and non-profit-making international non-governmental organisation. EADI has associate, institutional, individual and student members in 28 countries. Its working groups address key issues in development research, training and information.</skos:definition>
   </skos:Concept>
