   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/ILBC"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">ILBC</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001179</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:prefLabel xml:lang="bg">Международен библиотекарски и библиографски комитет</skos:prefLabel>
      <skos:prefLabel xml:lang="en">International Library and Bibliographical Committee</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Comité international bibliographique et des bibliothèques</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Rahvusvaheline raamatukogu ja bibliograafiline komitee</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kumitat Internazzjonali tal-Libreriji u l-Bibljografika</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Starptautiskā Bibliotēku un bibliogrāfijas komiteja</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Kansainvälinen kirjasto- ja bibliografinen komitea</skos:prefLabel>
      <dc:identifier>ILBC</dc:identifier>
      <atold:op-code>ILBC</atold:op-code>
      <at:op-code>ILBC</at:op-code>
      <at:start.use>1927-09-30</at:start.use>
      <at:authority-code>ILBC</at:authority-code>
      <at:end.use>1928-12-31</at:end.use>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:definition xml:lang="en">The Committee shall consist of members selected by the national library associations (…) The duties of the Committee shall be to select the time and place for international library conferences and, with the co-operation of local committees, to prepare programs for such conferences; and to make investigations and recommendations concerning international relations between libraries, organizations of librarians and bibliographers, andother agencies.</skos:definition>
      <skos:historyNote xml:lang="en">http://www.ifla.org/files/assets/hq/history/1927-resolution.pdf</skos:historyNote>
   </skos:Concept>
