      <skos:altLabel xml:lang="fr">CNUCED</skos:altLabel>
      <skos:altLabel xml:lang="el">ΔΗΕΕΑ</skos:altLabel>
      <skos:altLabel xml:lang="sv">Unctad</skos:altLabel>
      <skos:altLabel xml:lang="fi">UNCTAD</skos:altLabel>
