      <skos:altLabel xml:lang="sl">Karibski forum afriških, karibskih in pacifiških držav</skos:altLabel>
      <skos:altLabel xml:lang="lt">CARIFORUM</skos:altLabel>
      <skos:altLabel xml:lang="sl">CARIFORUM</skos:altLabel>
      <skos:altLabel xml:lang="en">CARIFORUM</skos:altLabel>
