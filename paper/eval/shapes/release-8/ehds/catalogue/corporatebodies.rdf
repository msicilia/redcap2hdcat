   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/AHWP_RESILIENCE"
                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001818</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">AHWP_RESILIENCE</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/CONSIL"/>
      <skos:prefLabel xml:lang="hu">A jövőbeli válságok vonatkozásában a felkészültséggel, a reagálási képességgel és a rezilienciával foglalkozó ad hoc munkacsoport</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Pasirengimo būsimoms krizėms, reagavimo į jas pajėgumų ir atsparumo joms stiprinimo ad hoc darbo grupė</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ad-hoc-Gruppe „Krisenvorsorge, Reaktionsfähigkeit und Resilienz gegenüber künftigen Krisen“</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">An Meitheal ad hoc maidir le hullmhacht, cumas freagartha agus athléimneacht i leith géarchéimeanna a bheidh ann amach anseo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Ad-hocgroep paraatheid, responscapaciteit en veerkracht bij toekomstige crises</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Varautumista, toimintakykyä ja selviytymiskykyä tulevien kriisien varalta käsittelevä ad hoc -työryhmä</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Pracovná skupina ad hoc pre pripravenosť, schopnosť reakcie a odolnosť voči budúcim krízam</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Grupo ad hoc sobre a preparação, a capacidade de resposta e a resiliência a futuras crises</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Ad hoc delovna skupina za pripravljenost, zmogljivost odzivanja in odpornost na prihodnje krize</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Ad hoc Ομάδα «Ετοιμότητα, ικανότητα αντίδρασης και ανθεκτικότητα σε μελλοντικές κρίσεις»</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Grupul de lucru ad-hoc pentru pregătirea, capacitatea de răspuns și reziliența la crize viitoare</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Работна група адхок „Готовност, способност за реагиране и устойчивост на бъдещи кризи“</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Grupp ta’ Ħidma ad hoc dwar it-tħejjija, il-kapaċità ta’ rispons u r-reżiljenza għal kriżijiet futuri</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Ad hoc-gruppen för beredskap, insatsförmåga och resiliens vid framtida kriser</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Grupa robocza ad hoc ds. gotowości, zdolności reagowania i odporności na przyszłe kryzysy</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Ad hoc pracovní skupina pro připravenost, schopnost reakce a odolnost vůči budoucím krizím</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Gruppo ad hoc "Rafforzamento della preparazione, della capacità di risposta e della resilienza alle crisi future"</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Ad-Hoc-Gruppen vedrørende Beredskabet, Indsatskapaciteten og Modstandsdygtighed over for Fremtidige Kriser</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Ad hoc radna skupina za pripravnost, sposobnost za odgovor i otpornost na buduće krize</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Grupo ad hoc «Preparación, Capacidad de Respuesta y Resiliencia ante Futuras Crisis»</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Groupe ad hoc sur la préparation, la capacité de réaction et la résilience face aux crises à venir</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Ajutine tulevaste kriisidega seotud valmisoleku, reageerimisvõime ja vastupanuvõime suurendamise töörühm</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Ad hoc Working Party on preparedness, response capability and resilience to future crises</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Sagatavotības, reaģēšanas spējas un noturības pret turpmākām krīzēm ad hoc darba grupa</skos:prefLabel>
      <dc:identifier>AHWP_RESILIENCE</dc:identifier>
      <atold:op-code>AHWP_RESILIENCE</atold:op-code>
      <at:op-code>AHWP_RESILIENCE</at:op-code>
      <at:start.use>2019-07-08</at:start.use>
      <at:authority-code>AHWP_RESILIENCE</at:authority-code>
