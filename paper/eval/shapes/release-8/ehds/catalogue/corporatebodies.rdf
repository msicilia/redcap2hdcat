   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_EURO19"
                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FD_050">EM-EURO</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_EURO19</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000982</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="et">Euro kasutusele võtnud liikmesriigid: Belgia, Saksamaa, Eesti, Iirimaa, Kreeka, Hispaania, Prantsusmaa, Itaalia, Küpros, Läti, Leedu, Luksemburg, Malta, Madalmaad, Austria, Portugal, Sloveenia, Slovakkia, Soome</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">De medlemsstater som har infört euron: Belgien, Tyskland, Estland, Irland, Grekland, Spanien, Frankrike, Italien, Cypern, Lettland, Litauen, Luxemburg, Malta, Nederländerna, Österrike, Portugal, Slovenien, Slovakien, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy, které přijaly euro: Belgie, Německo, Estonsko, Irsko, Řecko, Španělsko, Francie, Itálie, Kypr, Lotyšsko, Litva, Lucembursko, Malta, Nizozemsko, Rakousko, Portugalsko, Slovinsko, Slovensko, Finsko</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice koje su prihvatile euro: Belgija, Njemačka, Estonija, Irska, Grčka, Španjolska, Francuska, Italija, Cipar, Latvija, Litva, Luksemburg, Malta, Nizozemska, Austrija, Portugal, Slovenija, Slovačka, Finska</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členské štáty, ktoré prijali euro: Belgicko, Nemecko, Estónsko, Írsko, Grécko, Španielsko, Francúzsko, Taliansko, Cyprus, Lotyšsko, Litva, Luxembursko, Malta, Holandsko, Rakúsko, Portugalsko, Slovinsko, Slovensko, Fínsko</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki so sprejele euro: Belgija, Nemčija, Estonija, Irska, Grčija, Španija, Francija, Italija, Ciper, Latvija, Litva, Luksemburg, Malta, Nizozemska, Avstrija, Portugalska, Slovenija, Slovaška, Finska</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Valstybės narės, įsivedusios eurą: Belgija, Vokietija, Estija, Airija, Graikija, Ispanija, Prancūzija, Italija, Kipras, Latvija, Lietuva, Liuksemburgas, Malta, Nyderlandai, Austrija, Portugalija, Slovėnija, Slovakija, Suomija</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras ir ieviesušas euro: Beļģija, Vācija, Igaunija, Īrija, Grieķija, Spānija, Francija, Itālija, Kipra, Latvija, Lietuva, Luksemburga, Malta, Nīderlande, Austrija, Portugāle, Slovēnija, Slovākija, Somija</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави членки, които са приели еврото: Белгия, Германия, Естония, Ирландия, Гърция, Испания, Франция, Италия, Кипър, Латвия, Литва, Люксембург, Малта, Нидерландия, Австрия, Португалия, Словения, Словакия, Финландия</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres ayant adopté l’euro: Belgique, Allemagne, Estonie, Irlande, Grèce, Espagne, France, Italie, Chypre, Lettonie, Lituanie, Luxembourg, Malte, Pays-Bas, Autriche, Portugal, Slovénie, Slovaquie, Finlande</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Az eurót bevezető tagállamok: Belgium, Németország, Észtország, Írország, Görögország, Spanyolország, Franciaország, Olaszország, Ciprus, Lettország, Litvánia, Luxemburg, Málta, Hollandia, Ausztria, Portugália, Szlovénia, Szlovákia, Finnország</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Gli Stati membri che hanno adottato l’euro: Belgio, Germania, Estonia, Irlanda, Grecia, Spagna, Francia, Italia, Cipro, Lettonia, Lituania, Lussemburgo, Malta, Paesi Bassi, Austria, Portogallo, Slovenia, Slovacchia, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τα κράτη μέλη που υιοθέτησαν το ευρώ: Βέλγιο, Γερμανία, Εσθονία, Ιρλανδία, Ελλάδα, Ισπανία, Γαλλία, Ιταλία, Κύπρος, Λετονία, Λιθουανία, Λουξεμβούργο, Μάλτα, Κάτω Χώρες, Αυστρία, Πορτογαλία, Σλοβενία, Σλοβακία, Φινλανδία</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Na Ballstáit a ghlac leis an euro: an Bheilg, an Ghearmáin, an Eastóin, Éire, an Ghréig, an Spáinn, an Fhrainc, an Iodáil, an Chipir, an Laitvia, an Liotuáin, Lucsamburg, Málta, an Ísiltír, an Ostair, an Phortaingéil, an tSlóivéin, an tSlóvaic, an Fhionlainn</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Statele membre care au adoptat euro: Belgia, Germania, Estonia, Irlanda, Grecia, Spania, Franța, Italia, Cipru, Letonia, Lituania, Luxemburg, Malta, Țările de Jos, Austria, Portugalia, Slovenia, Slovacia, Finlanda</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">De lidstaten die de euro hebben aangenomen: België, Duitsland, Estland, Ierland, Griekenland, Spanje, Frankrijk, Italië, Cyprus, Letland, Litouwen, Luxemburg, Malta, Nederland, Oostenrijk, Portugal, Slovenië, Slowakije, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Los Estados miembros que han adoptado el euro: Bélgica, Alemania, Estonia, Irlanda, Grecia, España, Francia, Italia, Chipre, Letonia, Lituania, Luxemburgo, Malta, Países Bajos, Austria, Portugal, Eslovenia, Eslovaquia, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="en">The Member States having adopted the euro: Belgium, Germany, Estonia, Ireland, Greece, Spain, France, Italy, Cyprus, Latvia, Lithuania, Luxembourg, Malta, Netherlands, Austria, Portugal, Slovenia, Slovakia, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Os Estados-Membros que adotaram o euro: Bélgica, Alemanha, Estónia, Irlanda, Grécia, Espanha, França, Itália, Chipre, Letónia, Lituânia, Luxemburgo, Malta, Países Baixos, Áustria, Portugal, Eslovénia, Eslováquia, Finlândia</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri wara li adottaw l-euro: il-Belġju, il-Ġermanja, l-Estonja, l-Irlanda, il-Greċja, Spanja, Franza, l-Italja, Ċipru, il-Latvja, il-Litwanja, il-Lussemburgu, Malta, il-Pajjiżi l-Baxxi, l-Awstrija, il-Portugall, is-Slovenja, is-Slovakkja, il-Finlandja</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De medlemsstater, der har indført euroen: Belgien, Tyskland, Estland, Irland, Grækenland, Spanien, Frankrig, Italien, Cypern, Letland, Litauen, Luxembourg, Malta, Nederlandene, Østrig, Portugal, Slovenien, Slovakiet, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Die Mitgliedstaaten, die den Euro eingeführt haben: Belgien, Deutschland, Estland, Irland, Griechenland, Spanien, Frankreich, Italien, Zypern, Lettland, Litauen, Luxemburg, Malta, Niederlande, Österreich, Portugal, Slowenien, Slowakei, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwa członkowskie, które przyjęły walutę euro: Belgia, Niemcy, Estonia, Irlandia, Grecja, Hiszpania, Francja, Włochy, Cypr, Łotwa, Litwa, Luksemburg, Malta, Niderlandy, Austria, Portugalia, Słowenia, Słowacja, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Jäsenvaltiot, jotka ovat ottaneet käyttöön euron: Belgia, Saksa, Viro, Irlanti, Kreikka, Espanja, Ranska, Italia, Kypros, Latvia, Liettua, Luxemburg, Malta, Alankomaat, Itävalta, Portugali, Slovenia, Slovakia, Suomi</skos:prefLabel>
      <dc:identifier>EUMS_EURO19</dc:identifier>
      <atold:op-code>EUMS_EURO19</atold:op-code>
      <at:op-code>EUMS_EURO19</at:op-code>
