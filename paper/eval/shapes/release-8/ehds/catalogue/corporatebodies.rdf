      <skos:altLabel xml:lang="en">Presidency of the Council of the European Union</skos:altLabel>
      <skos:altLabel xml:lang="it">Presidenza del Consiglio dell’Unione europea</skos:altLabel>
      <skos:altLabel xml:lang="et">Euroopa Liidu Nõukogu eesistuja</skos:altLabel>
