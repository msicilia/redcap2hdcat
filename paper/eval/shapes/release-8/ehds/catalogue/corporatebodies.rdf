      <skos:altLabel xml:lang="hu">CEN</skos:altLabel>
      <skos:altLabel xml:lang="en">CEN</skos:altLabel>
      <skos:altLabel xml:lang="it">CEN</skos:altLabel>
      <skos:altLabel xml:lang="sl">CEN</skos:altLabel>
      <skos:altLabel xml:lang="sv">CEN</skos:altLabel>
