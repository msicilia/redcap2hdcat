      <skos:altLabel xml:lang="sv">IMO</skos:altLabel>
      <skos:altLabel xml:lang="nl">IMO</skos:altLabel>
      <skos:altLabel xml:lang="hr">IMO</skos:altLabel>
      <skos:altLabel xml:lang="mt">IMO</skos:altLabel>
      <skos:altLabel xml:lang="sl">IMO</skos:altLabel>
