      <skos:altLabel xml:lang="ga">Coiste um Chearta an Duine</skos:altLabel>
      <skos:altLabel xml:lang="sl">Odbor za človekove pravice</skos:altLabel>
      <skos:altLabel xml:lang="en">CCPR</skos:altLabel>
      <skos:altLabel xml:lang="nl">HRC</skos:altLabel>
      <skos:altLabel xml:lang="fr">CCPR</skos:altLabel>
