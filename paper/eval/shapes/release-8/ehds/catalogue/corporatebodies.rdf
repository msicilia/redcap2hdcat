                 at:deprecated="false">
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">CMT_ADVIS_MERGER</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000775</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EURUN"/>
      <skos:prefLabel xml:lang="bg">Kонсултативен kомитет за kонцентрациите</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Keskittymiä käsittelevä neuvoa-antava komitea</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Beratender Ausschuss für Unternehmenszusammenschlüsse</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Padomdevēja komiteja uzņēmumu koncentrācijas jautājumos</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Comité consultivo de concentraciones</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Det Rådgivende Udvalg for Kontrol med Fusioner og Virksomhedsovertagelser</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Comitet consultativ în materie de concentrări</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Savjetodavnim odborom za koncentracije</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Advisory Committee on Concentrations</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Svetovalnim odborom za koncentracije</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Poradný výbor pre koncentrácie</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Poradní výbor pro spojování</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Συμβουλευτική επιτροπή συγκεντρώσεων</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Összefonódásokkal foglalkozó tanácsadó bizottság</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Adviescomité voor concentraties</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kumitat konsultattiv dwar il-konċentrazzjonijiet</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Komitet Doradczy ds. Koncentracji</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Rådgivande kommittèn för företagskoncentrationer</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Koondumist käsitleva nõuandekomiteega</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Comité consultatif en matière de concentrations</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Comité Consultivo em matéria de Concentrações</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Koncentracijų patariamasis komitetas</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">An Coiste Comhairleach um Chomhchruinnithe</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Comitato consultivo in materia di concentrazioni</skos:prefLabel>
      <dc:identifier>CMT_ADVIS_MERGER</dc:identifier>
      <atold:op-code>CMT_ADVIS_MERGER</atold:op-code>
      <at:op-code>CMT_ADVIS_MERGER</at:op-code>
      <at:start.use>1990-09-21</at:start.use>
      <at:authority-code>CMT_ADVIS_MERGER</at:authority-code>
      <skos:definition xml:lang="en">Committee, composed of representatives of the Member States, which is consulted by the Commission in antitrust and merger cases where such a consultation is foreseen. A preliminary draft decision by the Commission is submitted to, and discussed with, the advisory committee in question. The advisory committee issues an opinion, which shall be taken into account in the final Commission decision.</skos:definition>
      <skos:definition xml:lang="fr">Comité, composé de représentants des États membres, que la Commission consulte dans les affaires d’entente et de concentration, lorsque cette consultation est prévue. La Commission lui présente un avant-projet de décision et l’examine avec lui. Le comité consultatif émet un avis, qui doit être pris en compte dans la décision finale de la Commission.</skos:definition>
      <skos:historyNote xml:lang="en">Alternative label: Advisory Committee on Mergers</skos:historyNote>
   </skos:Concept>
