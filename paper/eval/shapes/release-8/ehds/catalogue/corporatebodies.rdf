      <skos:prefLabel xml:lang="hu">Európai Szakszervezeti Intézet</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Ευρωπαϊκό Συνδικαλιστικό Ινστιτούτο</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Europski sindikalni institut</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Det Europæiske Fagforeningsinstitut</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Europäisches Gewerkschaftsinstitut</skos:prefLabel>
