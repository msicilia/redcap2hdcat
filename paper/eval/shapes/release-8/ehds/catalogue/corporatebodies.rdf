      <skos:altLabel xml:lang="ga">NAT</skos:altLabel>
      <skos:altLabel xml:lang="hu">NAT</skos:altLabel>
      <skos:altLabel xml:lang="pt">NAT</skos:altLabel>
      <skos:altLabel xml:lang="bg">NAT</skos:altLabel>
      <skos:altLabel xml:lang="sv">NAT</skos:altLabel>
