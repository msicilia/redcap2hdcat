      <skos:prefLabel xml:lang="fr">Banques nationales n’appartenant pas à l’Eurosystème: Danmarks Nationalbank, Sveriges Riksbank, Bank of England</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nationale Zentralbanken außerhalb des Eurosystems: Danmarks Nationalbank, Sveriges Riksbank, Bank of England</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Εθνικές τράπεζες εκτός του Ευρωσυστήματος: Danmarks Nationalbank, Sveriges Riksbank, Bank of England</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Nationale banken buiten het Eurosysteem: Danmarks Nationalbank, Sveriges Riksbank, Bank of England</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Bainc náisiúnta lasmuigh den Eurochóras: Danmarks Nationalbank, Sveriges Riksbank, Bank of England</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Nacionalne banke izvan Eurosustava: Danmarks Nationalbank, Sveriges Riksbank, Bank of England</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Eurosistemai nepriklausantys nacionaliniai bankai: Danmarks Nationalbank, Sveriges Riksbank, Bank of England</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Национални банки извън Евросистемата: Danmarks Nationalbank, Sveriges Riksbank, Bank of England</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Banek nazzjonali barra l-Eurosistema: Danmarks Nationalbank, Sveriges Riksbank, Bank of England</skos:prefLabel>
