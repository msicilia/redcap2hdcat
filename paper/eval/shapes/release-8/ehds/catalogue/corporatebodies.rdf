      <skos:altLabel xml:lang="lv">Eiropas Robežu un krasta apsardzes aģentūra</skos:altLabel>
      <skos:altLabel xml:lang="et">Euroopa Piiri- ja Rannikuvalve Amet</skos:altLabel>
      <skos:altLabel xml:lang="es">Agencia Europea de la Guardia de Fronteras y Costas</skos:altLabel>
      <skos:altLabel xml:lang="da">Det Europæiske Agentur for Grænse- og Kystbevogtning</skos:altLabel>
      <skos:altLabel xml:lang="de">Europäische Agentur für die Grenz- und Küstenwache</skos:altLabel>
      <skos:altLabel xml:lang="sk">Európska agentúra pre pohraničnú a pobrežnú stráž</skos:altLabel>
