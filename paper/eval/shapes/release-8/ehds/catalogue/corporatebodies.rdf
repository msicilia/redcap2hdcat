   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/SHCMOEI_1965_0"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#PUB_CORP">OSS</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001365</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FD_050">SECMIN-ORG</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/ECSC"/>
      <skos:prefLabel xml:lang="sv">Ständiga kommittén för driftssäkerhet i stenkolsgruvor</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Toimivaltuuksista ja työjärjestyksestä</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Kőszénbányák biztonságával foglalkozó állandó bizottság</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Organe permanent pour la sécurité et la salubrité dans les mines de houille</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Mines Safety and Health Commission</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Órgão Permanente para a Segurança e Salubridade nas Minas de Hulha</skos:prefLabel>
      <dc:identifier>SHCMOEI_1965_0</dc:identifier>
      <atold:op-code>SHCMOEI_1965_0</atold:op-code>
      <at:op-code>SHCMOEI_1965_0</at:op-code>
      <at:start.use>1965-03-11</at:start.use>
      <at:authority-code>SHCMOEI_1965_0</at:authority-code>
      <at:end.use>1998-06-24</at:end.use>
      <skos:definition xml:lang="en">The Safety Commission was responsible for following developments in safety in coal mines, including safety regulations made by the public authorities, and for assembling the necessary information on progress made and practical results obtained, particularly in the field of accident prevention. The Safety Commission made use of the information in its possession in order to submit proposals to the Governments for the improvement of safety in coal mines.</skos:definition>
   </skos:Concept>
