   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_EURO17"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000345</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_EURO17</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="de">Die Mitgliedstaaten, die den Euro eingeführt haben: Belgien, Deutschland, Estland, Irland, Griechenland, Spanien, Frankreich, Italien, Zypern, Luxemburg, Malta, Niederlande, Österreich, Portugal, Slowenien, Slowakei, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави-членки, които са приели еврото: Белгия, Германия, Естония, Ирландия, Гърция, Испания, Франция, Италия, Кипър, Люксембург, Малта, Австрия, Нидерландия, Португалия, Словения, Словаки, Финландия</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euro kasutusele võtnud liikmesriigid: Belgia, Saksamaa, Eesti, Iirimaa, Kreeka, Hispaania, Prantsusmaa, Itaalia, Küpros, Luksemburg, Malta, Madalmaad, Austria, Portugal, Sloveenia, Slovakkia, Soome</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Valstybės narės, įsivedusios eurą: Belgija, Vokietija, Estija, Airija, Graikija, Ispanija, Prancūzija, Italija, Kipras, Liuksemburgas, Malta, Nyderlandai, Austrija, Portugalija, Slovėnija, Slovakija, Suomija</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členské štáty, ktoré prijali euro: Belgicko, Nemecko, Estónsko, Írsko, Grécko, Španielsko, Francúzsko, Taliansko, Cyprus, Luxembursko, Malta, Holandsko, Rakúsko, Portugalsko, Slovinsko, Slovensko, Fínsko</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Los Estados miembros que han adoptado el euro: Bélgica, Alemania, Estonia, Irlanda, Grecia, España, Francia, Italia, Chipre, Luxemburgo, Malta, Países Bajos, Austria, Portugal, Eslovenia, Eslovaquia, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri wara li adottaw l-euro: il-Belġju, il-Ġermanja, l-Estonja, l-Irlanda, il-Greċja, Spanja, Franza, l-Italja, Ċipru, il-Lussemburgu, Malta, il-Pajjiżi l-Baxxi, l-Awstrija, il-Portugall, is-Slovenja, is-Slovakkja, il-Finlandja</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Jäsenvaltiot, jotka ovat ottaneet käyttöön euron: Belgia, Saksa, Viro, Irlanti, Kreikka, Espanja, Ranska, Italia, Kypros, Luxemburg, Malta, Alankomaat, Itävalta, Portugali, Slovenia, Slovakia, Suomi</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice koje su prihvatile euro: Belgija, Njemačka, Estonija, Irska, Grčka, Španjolska, Francuska, Italija, Cipar, Luksemburg, Malta, Nizozemska, Austrija, Portugal, Slovenija, Slovačka, Finska</skos:prefLabel>
      <skos:prefLabel xml:lang="da">De medlemsstater, der har indført euroen: Belgien, Tyskland, Estland, Irland, Grækenland, Spanien, Frankrig, Italien, Cypern, Luxembourg, Malta, Nederlandene, Østrig, Portugal, Slovenien, Slovakiet, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τα κράτη μέλη που υιοθέτησαν το ευρώ: Βέλγιο, Γερμανία, Εσθονία, Ιρλανδία, Ελλάδα, Ισπανία, Γαλλία, Ιταλία, Κύπρος, Λουξεμβούργο, Μάλτα, Κάτω Χώρες, Αυστρία, Πορτογαλία, Σλοβενία, Σλοβακία, Φινλανδία</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">De lidstaten die de euro hebben aangenomen: België, Duitsland, Estland, Ierland, Griekenland, Spanje, Frankrijk, Italië, Cyprus, Luxemburg, Malta, Nederland, Oostenrijk, Portugal, Slovenië, Slowakije, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwa członkowskie, które przyjęły walutę euro: Belgia, Niemcy, Estonia, Irlandia, Grecja, Hiszpania, Francja, Włochy, Cypr, Luksemburg, Malta, Niderlandy, Austria, Portugalia, Słowenia, Słowacja, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres ayant adopté l’euro: Belgique, Allemagne, Estonie, Irlande, Grèce, Espagne, France, Italie, Chypre, Luxembourg, Malte, Pays-Bas, Autriche, Portugal, Slovénie, Slovaquie, Finlande</skos:prefLabel>
      <skos:prefLabel xml:lang="it">I Stati membri che hanno adottato l’euro: Belgio, Germania, Estonia, Irlanda, Grecia, Spagna, Francia, Italia, Cipro, Lussemburgo, Malta, Paesi Bassi, Austria, Portogallo, Slovenia, Slovacchia, Finlandia</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki so sprejele euro: Belgija, Nemčija, Estonija, Irska, Grčija, Španija, Francija, Italija, Ciper, Luksemburg, Malta, Nizozemska, Avstrija, Portugalska, Slovenija, Slovaška, Finska</skos:prefLabel>
      <skos:prefLabel xml:lang="en">The Member States having adopted the euro: Belgium, Germany, Estonia, Ireland, Greece, Spain, France, Italy, Cyprus, Luxembourg, Malta, Netherlands, Austria, Portugal, Slovenia, Slovakia, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Na Ballstáit a ghlac leis an euro: an Bheilg, an Ghearmáin, an Eastóin, Éire, an Ghréig, an Spáinn, an Fhrainc, an Iodáil, an Chipir, Lucsamburg, Málta, an Ísiltír, an Ostair, an Phortaingéil, an tSlóivéin, an tSlóvaic, an Fhionlainn</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">De medlemsstater som har infört euron: Belgien, Tyskland, Estland, Irland, Grekland, Spanien, Frankrike, Italien, Cypern, Luxemburg, Malta, Nederländerna, Österrike, Portugal, Slovenien, Slovakien, Finland</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy, které přijaly euro: Belgie, Německo, Estonsko, Irsko, Řecko, Španělsko, Francie, Itálie, Kypr, Lucembursko, Malta, Nizozemsko, Rakousko, Portugalsko, Slovinsko, Slovensko, Finsko</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras ir ieviesušas euro: Beļģija, Vācija, Igaunija, Īrija, Grieķija, Spānija, Francija, Itālija, Kipra, Luksemburga, Malta, Nīderlande, Austrija, Portugāle, Slovēnija, Slovākija, Somija</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Az eurót bevezető tagállamok: Belgium, Németország, Észtország, Írország, Görögország, Spanyolország, Franciaország, Olaszország, Ciprus, Luxemburg, Málta, Hollandia, Ausztria, Portugália, Szlovénia, Szlovákia, Finnország</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Statele membre care au adoptat euro: Belgia, Germania, Estonia, Irlanda, Grecia, Spania, Franţa, Italia, Cipru, Luxemburg, Malta, Ţările de Jos, Austria, Portugalia, Slovenia, Slovacia, Finlanda</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Os Estados-Membros que adoptaram o euro: Bélgica, Alemanha, Estónia, Irlanda, Grécia, Espanha, França, Itália, Chipre, Luxemburgo, Malta, Países Baixos, Áustria, Portugal, Eslovénia, Eslováquia, Finlândia</skos:prefLabel>
      <dc:identifier>EUMS_EURO17</dc:identifier>
      <atold:op-code>EUMS_EURO17</atold:op-code>
      <at:op-code>EUMS_EURO17</at:op-code>
      <at:start.use>2011-01-01</at:start.use>
      <at:authority-code>EUMS_EURO17</at:authority-code>
      <at:end.use>2013-12-31</at:end.use>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/corporate-body/EUMS_NONEURO3"
                 at:deprecated="true">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">EUMS_NONEURO3</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0000347</skos:notation>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
      <skos:broader rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/EUMS"/>
      <skos:prefLabel xml:lang="ga">Ballstáit nach bhfuil sa limistéar euro: an Danmhairg, an tSualainn, an Ríocht Aontaithe</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Euróövezeten kívüli tagállamok: Dánia, Svédország, Egyesült Királyság</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Členské státy mimo eurozónu: Dánsko, Švédsko, Spojené království</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Dalībvalstis, kuras nav ieviesušas euro: Dānija, Zviedrija, Apvienotā Karaliste</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Euro zonai nepriklausančios valstybės narės: Danija, Švedija, Jungtinė Karalystė</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Države članice, ki niso v euroobmočju: Danska, Švedska, Združeno kraljestvo</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Държави-членки извън еврозоната: Дания, Швеция, Обединеното кралство</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Estados-Membros não participante na área do euro: Dinamarca, Suécia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Medlemsstater uden for Euroområdet: Danmark, Sverige, Det Forenede Kongerige</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">State membre din afara zonei euro: Danemarca, Suedia, Regatul Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">L-Istati Membri mhux fiż-żona tal-euro: id-Danimarka, l-Isvezja, ir-Renju Unit</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Euroalasse mittekuuluvad liikmesriigid: Taani, Rootsi, Ühendkuningriik</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Euroalueen ulkopuoliset jäsenvaltiot: Tanska, Ruotsi, Yhdistynyt kuningaskunta</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Estados miembros no pertenecientes a la zona del euro: Dinamarca, Suecia, Reino Unido</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Lidstaten buiten de eurozone: Denemarken, Zweden, Verenigd Koninkrijk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nicht dem Euro-Währungsgebiet angehörende Mitgliedstaaten: Dänemark, Schweden, Vereinigtes Königreich</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Non-euro area Member States: Denmark, Sweden, United Kingdom</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Države članice izvan europodručja: Danska, Švedska, Ujedinjena kraljevina</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Medlemsstater utanför euroområdet: Danmark, Sverige, Förenade kungariket</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">États membres n’appartenant pas à la zone euro: Danemark, Suède, Royaume-Uni</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Państwo członkowskie spoza strefy euro: Dania, Szwecja, Zjednoczone Królestwo</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Členský štát, ktorý nie je krajinou eurozóny: Dánsko, Švédsko, Spojené kráľovstvo</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κράτη μέλη εκτός ζώνης ευρώ: Δανία, Σουηδία, Ηνωμένο Βασίλειο</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Stati membri non appartenenti all’area dell’euro: Danimarca, Svezia, Regno Unito</skos:prefLabel>
