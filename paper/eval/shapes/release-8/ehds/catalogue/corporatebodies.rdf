      <skos:prefLabel xml:lang="nl">Permanente vertegenwoordigingen</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Μόνιμες Αντιπροσωπείες</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ständige Vertretungen</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Représentations permanentes</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Nuolatinės atstovybės</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Stalna predstavništva</skos:prefLabel>
